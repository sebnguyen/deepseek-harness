{
  "name": "@deepseek-ai/dsh-vscode-bridge",
  "description": "Bridge extension for the embedded VS Code REH editor frame: hello and open downlink over the gateway, one-first-activation chrome posture, dsh-dark theme seat",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/entry.js",
  "types": "lib/types/entry.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/entry.d.ts",
      "default": "./lib/entry.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-gateway": "workspace:^",
    "@deepseek-ai/dsh-checkpoint": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-host-ide": "workspace:^",
    "@deepseek-ai/dsh-typert-registry": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "files": [
    "lib/entry.js",
    "lib/types/**/*.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/ide/bridge"
  }
}
