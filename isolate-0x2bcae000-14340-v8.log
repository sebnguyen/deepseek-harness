n\x09\x09* @param agent - the session's live agent\x2C resolved from the wire identity.\n\x09\x09* @param agentPreset - the preset to compose the agent from instead.\n\x09\x09* @returns the preset id that was recorded.\n\x09\x09* @throws {RemoteError} with `gateway/bad-request`\x2C `agent-preset/locked`\x2C\n\x09\x09* `agent-preset/not-found`\x2C or `agent-preset/invalid` when refused.\n\x09\x09*/\n\x09\x09async select(agent\x2C agentPreset) {\n\x09\x09\x09validatePresetId(agentPreset\x2C "agentPreset");\n\x09\x09\x09const turn = (this.switches.get(agent.id) ?? Promise.resolve()).then(() => this.swap(agent\x2C agentPreset));\n\x09\x09\x09const guard = turn.catch(() => void 0);\n\x09\x09\x09this.switches.set(agent.id\x2C guard);\n\x09\x09\x09try {\n\x09\x09\x09\x09return await turn;\n\x09\x09\x09} finally {\n\x09\x09\x09\x09if (this.switches.get(agent.id) === guard) this.switches.delete(agent.id);\n\x09\x09\x09}\n\x09\x09}\n\x09\x09/** One queued switch: re-check\x2C recompose\x2C then record what the agent runs. */\n\x09\x09async swap(agent\x2C agentPreset) {\n\x09\x09\x09const boundary = this.selfCtx.sessionProjections.stateOf(agent.session\x2C "turnBoundary");\n\x09\x09\x09if (boundary !== void 0 && (boundary.openTurnStartSeq !== null || boundary.lastTurn > 0)) throw new RemoteError("agent-preset/locked"\x2C `session "${agent.id}" has already started; its agent preset is fixed`\x2C {\n\x09\x09\x09\x09sessionId: agent.id\x2C\n\x09\x09\x09\x09agentPreset\n\x09\x09\x09});\n\x09\x09\x09const preset = await this.recompose(agent.ctx\x2C agentPreset);\n\x09\x09\x09agent.session.append("agent-preset/selected"\x2C { agentPreset: preset.id });\n\x09\x09\x09return preset.id;\n\x09\x09}\n\x09\x09/**\n\x09\x09* The standing scope key of one preset\x2C for a host reader with no agent.\n\x09\x09*\n\x09\x09* A cold transcript read resolves tool presenters against the composition\n\x09\x09* the session recorded\x2C and the standing mount makes that possible without\n\x09\x09* resu