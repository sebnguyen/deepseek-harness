script-source,287,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/util/deque/lib/index.js,//#region lib/types/index.js\n/**\n* Zero-dependency circular deque for queues that retain entries across asynchronous work.\n* @module @deepseek-ai/dsh-deque\n*/\nconst MIN_CAPACITY = 16;\n/**\n* A circular deque with amortized constant-time insertion and removal.\n* Removed entries are cleared immediately\x2C and sparse storage shrinks after\n* the live entry count reaches one quarter of its capacity.\n*/\nvar Deque = class {\n\x09buffer = new Array(MIN_CAPACITY);\n\x09head = 0;\n\x09count = 0;\n\x09/** Number of entries available to remove. */\n\x09get size() {\n\x09\x09return this.count;\n\x09}\n\x09/**\n\x09* Append one entry after the current tail.\n\x09* @param value - entry to append.\n\x09*/\n\x09pushBack(value) {\n\x09\x09this.ensureCapacity();\n\x09\x09const tail = this.head + this.count;\n\x09\x09this.buffer[tail < this.buffer.length ? tail : tail - this.buffer.length] = value;\n\x09\x09this.count += 1;\n\x09}\n\x09/**\n\x09* Insert one entry before the current head.\n\x09* @param value - entry to prepend.\n\x09*/\n\x09pushFront(value) {\n\x09\x09this.ensureCapacity();\n\x09\x09this.head = this.head === 0 ? this.buffer.length - 1 : this.head - 1;\n\x09\x09this.buffer[this.head] = value;\n\x09\x09this.count += 1;\n\x09}\n\x09/**\n\x09* Remove the current head entry and clear its retained reference.\n\x09* Callers whose element type includes `undefined` use {@link size} to\n\x09* distinguish an empty deque from an `undefined` entry.\n\x09* @returns the removed entry\x2C or `undefined` when the deque is empty.\n\x09*/\n\x09popFront() {\n\x09\x09if (this.count === 0) return void 0;\n\x09\x09const value = this.buffer[this.head];\n\x09\x09this.buffer[this.head] = void 0;\n\x09\x09this.head += 1;\n\x09\x09if (this.head === this.buffer.length) this.head = 0;\n\x09\x09this.count -= 1;\n\x09\x09this.compact();\n\x09\x09return value;\n\x09}\n\x09/** Drop every entry and release the current backing storage. */\n\x09clear() {\n\x09\x09this.buffer = new Array(MIN_CAPACITY);\n\x09\x09this.head = 0;\n\x09\x09this.count = 0;\n\x09}\n\x09ensureCapacity() {\n\x09\x09if (this.count < this.buffer.length) return;\n\x09\x09this.resize(this.buffer.length * 2);\n\x09}\n\x09compact() {\n\x09\x09if (this.count === 0) {\n\x09\x09\x09this.head = 0;\n\x09\x09\x09return;\n\x09\x09}\n\x09\x09if (this.buffer.length > MIN_CAPACITY && this.count <= this.buffer.length / 4) this.resize(Math.max(MIN_CAPACITY\x2C this.buffer.length / 2));\n\x09}\n\x09resize(capacity) {\n\x09\x09const next = new Array(capacity);\n\x09\x09let source = this.head;\n\x09\x09for (let index = 0; index < this.count; index += 1) {\n\x09\x09\x09next[index] = this.buffer[source];\n\x09\x09\x09source += 1;\n\x09\x09\x09if (source === this.buffer.length) source = 0;\n\x09\x09}\n\x09\x09this.buffer = next;\n\x09\x09this.head = 0;\n\x09}\n};\n//#endregion\nexport { Deque };\n
