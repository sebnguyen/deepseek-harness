script-source,195,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod/v4/locales/sv.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "tecken"\x2C verb: "att ha" }\x2C\n        file: { unit: "bytes"\x2C verb: "att ha" }\x2C\n        array: { unit: "objekt"\x2C verb: "att inneh\xe5lla" }\x2C\n        set: { unit: "objekt"\x2C verb: "att inneh\xe5lla" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "regulj\xe4rt uttryck"\x2C\n        email: "e-postadress"\x2C\n        url: "URL"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "ISO-datum och tid"\x2C\n        date: "ISO-datum"\x2C\n        time: "ISO-tid"\x2C\n        duration: "ISO-varaktighet"\x2C\n        ipv4: "IPv4-intervall"\x2C\n        ipv6: "IPv6-intervall"\x2C\n        cidrv4: "IPv4-spektrum"\x2C\n        cidrv6: "IPv6-spektrum"\x2C\n        base64: "base64-kodad str\xe4ng"\x2C\n        base64url: "base64url-kodad str\xe4ng"\x2C\n        json_string: "JSON-str\xe4ng"\x2C\n        e164: "E.164-nummer"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "mall-literal"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "antal"\x2C\n        array: "lista"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Ogiltig inmatning: f\xf6rv\xe4ntat instanceof ${issue.expected}\x2C fick ${received}`;\n                }\n                return `Ogiltig inmatning: f\xf6rv\xe4ntat ${expected}\x2C fick ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Ogiltig inmatning: f\xf6rv\xe4ntat ${util.stringifyPrimitive(issue.values[0])}`;\n                return `Ogiltigt val: f\xf6rv\xe4ntade en av ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `F\xf6r stor(t): f\xf6rv\xe4ntade ${issue.origin ?? "v\xe4rdet"} att ha ${adj}${issue.maximum.toString()} ${sizing.unit ?? "element"}`;\n                }\n                return `F\xf6r stor(t): f\xf6rv\xe4ntat ${issue.origin ?? "v\xe4rdet"} att ha ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `F\xf6r lite(t): f\xf6rv\xe4ntade ${issue.origin ?? "v\xe4rdet"} att ha ${adj}${issue.minimum.toString()} ${sizing.unit}`;\n                }\n                return `F\xf6r lite(t): f\xf6rv\xe4ntade ${issue.origin ?? "v\xe4rdet"} att ha ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with") {\n                    return `Ogiltig str\xe4ng: m\xe5ste b\xf6rja med "${_issue.prefix}"`;\n                }\n                if (_issue.format === "ends_with")\n                    return `Ogiltig str\xe4ng: m\xe5ste sluta med "${_issue.suffix}"`;\n                if (_issue.format === "includes")\n                    return `Ogiltig str\xe4ng: m\xe5ste inneh\xe5lla "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `Ogiltig str\xe4ng: m\xe5ste matcha m\xf6nstret "${_issue.pattern}"`;\n                return `Ogiltig(t) ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `Ogiltigt tal: m\xe5ste vara en multipel av ${issue.divisor}`;\n            case "unrecognized_keys":\n                return `${issue.keys.length > 1 ? "Ok\xe4nda nycklar" : "Ok\xe4nd nyckel"}: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `Ogiltig nyckel i ${issue.origin ?? "v\xe4rdet"}`;\n            case "invalid_union":\n                return "Ogiltig input";\n            case "invalid_element":\n                return `Ogiltigt v\xe4rde i ${issue.origin ?? "v\xe4rdet"}`;\n            default:\n                return `Ogiltig input`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
