        check: "custom"\x2C\n        fn: fn\x2C\n        ...util.normalizeParams(_params)\x2C\n    });\n    return schema;\n}\n// @__NO_SIDE_EFFECTS__\nexport function _superRefine(fn\x2C params) {\n    const ch = _check((payload) => {\n        payload.addIssue = (issue) => {\n            if (typeof issue === "string") {\n                payload.issues.push(util.issue(issue\x2C payload.value\x2C ch._zod.def));\n            }\n            else {\n                // for Zod 3 backwards compatibility\n                const _issue = issue;\n                if (_issue.fatal)\n                    _issue.continue = false;\n                _issue.code ?? (_issue.code = "custom");\n                _issue.input ?? (_issue.input = payload.value);\n                _issue.inst ?? (_issue.inst = ch);\n                _issue.continue ?? (_issue.continue = !ch._zod.def.abort); // abort is always undefined\x2C so this is always true...\n                payload.issues.push(util.issue(_issue));\n            }\n        };\n        return fn(payload.value\x2C payload);\n    }\x2C params);\n    return ch;\n}\n// @__NO_SIDE_EFFECTS__\nexport function _check(fn\x2C params) {\n    const ch = new checks.$ZodCheck({\n        check: "custom"\x2C\n        ...util.normalizeParams(params)\x2C\n    });\n    ch._zod.check = fn;\n    return ch;\n}\n// @__NO_SIDE_EFFECTS__\nexport function describe(description) {\n    const ch = new checks.$ZodCheck({ check: "describe" });\n    ch._zod.onattach = [\n        (inst) => {\n            const existing = registries.globalRegistry.get(inst) ?? {};\n            registries.globalRegistry.add(inst\x2C { ...existing\x2C description });\n        }\x2C\n    ];\n    ch._zod.check = () => { }; // no-op check\n    return ch;\n}\n// @__NO_SIDE_EFFECTS__\nexport function meta(metadata) {\n    const ch = new checks.$ZodCheck({ check: "meta" });\n    ch._zod.onattach = [\n        (inst) => {\n            const existing = registries.globalRegistry.get(inst) ?? {};\n            registries.globalRegistry.add(inst\x2C { ...existing\x2C ...metadata });\n        }\x2C\n    ];\n    ch._zod.check = () => { }; // no-op check\n    return ch;\n}\n// @__NO_SIDE_EFFECTS__\nexport function _stringbool(Classes\x2C _params) {\n    const params = util.normalizeParams(_params);\n    let truthyArray = params.truthy ?? ["true"\x2C "1"\x2C "yes"\x2C "on"\x2C "y"\x2C "enabled"];\n    let falsyArray = params.falsy ?? ["false"\x2C "0"\x2C "no"\x2C "off"\x2C "n"\x2C "disabled"];\n    if (params.case !== "sensitive") {\n        truthyArray = truthyArray.map((v) => (typeof v === "string" ? v.toLowerCase() : v));\n        falsyArray = falsyArray.map((v) => (typeof v === "string" ? v.toLowerCase() : v));\n    }\n    const truthySet = new Set(truthyArray);\n    const falsySet = new Set(falsyArray);\n    const _Codec = Classes.Codec ?? schemas.$ZodCodec;\n    const _Boolean = Classes.Boolean ?? schemas.$ZodBoolean;\n    const _String = Classes.String ?? schemas.$ZodString;\n    const stringSchema = new _String({ type: "string"\x2C error: params.error });\n    const booleanSchema = new _Boolean({ type: "boolean"\x2C error: params.error });\n    const codec = new _Codec({\n        type: "pipe"\x2C\n        in: stringSchema\x2C\n        out: booleanSchema\x2C\n        transform: ((input\x2C payload) => {\n            let data = input;\n            if (params.case !== "sensitive")\n                data = data.toLowerCase();\n            if (truthySet.has(data)) {\n                return true;\n            }\n            else if (falsySet.has(data)) {\n                return false;\n            }\n            else {\n                payload.issues.push({\n                    code: "invalid_value"\x2C\n                    expected: "stringbool"\x2C\n                    values: [...truthySet\x2C ...falsySet]\x2C\n                    input: payload.value\x2C\n                    inst: codec\x2C\n                    continue: false\x2C\n                });\n                return {};\n            }\n        })\x2C\n        reverseTransform: ((input\x2C _payload) => {\n            if (input === true) {\n                return truthyArray[0] || "true";\n            }\n            else {\n                return falsyArray[0] || "false";\n            }\n        })\x2C\n        error: params.error\x2C\n    });\n    return codec;\n}\n// @__NO_SIDE_EFFECTS__\nexport function _stringFormat(Class\x2C format\x2C fnOrRegex\x2C _params = {}) {\n    const params = util.normalizeParams(_params);\n    const def = {\n        ...util.normalizeParams(_params)\x2C\n        check: "string_format"\x2C\n        type: "string"\x2C\n        format\x2C\n        fn: typeof fnOrRegex === "function" ? fnOrRegex : (val) => fnOrRegex.test(val)\x2C\n        ...params\x2C\n    };\n    if (fnOrRegex instanceof RegExp) {\n        def.pattern = fnOrRegex;\n    }\n    const inst = new Class(def);\n    return inst;\n}\n
