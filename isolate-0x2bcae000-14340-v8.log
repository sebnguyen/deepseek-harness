script-source,176,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod/v4/locales/is.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "stafi"\x2C verb: "a\xf0 hafa" }\x2C\n        file: { unit: "b\xe6ti"\x2C verb: "a\xf0 hafa" }\x2C\n        array: { unit: "hluti"\x2C verb: "a\xf0 hafa" }\x2C\n        set: { unit: "hluti"\x2C verb: "a\xf0 hafa" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "gildi"\x2C\n        email: "netfang"\x2C\n        url: "vefsl\xf3\xf0"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "ISO dagsetning og t\xedmi"\x2C\n        date: "ISO dagsetning"\x2C\n        time: "ISO t\xedmi"\x2C\n        duration: "ISO t\xedmalengd"\x2C\n        ipv4: "IPv4 address"\x2C\n        ipv6: "IPv6 address"\x2C\n        cidrv4: "IPv4 range"\x2C\n        cidrv6: "IPv6 range"\x2C\n        base64: "base64-encoded strengur"\x2C\n        base64url: "base64url-encoded strengur"\x2C\n        json_string: "JSON strengur"\x2C\n        e164: "E.164 t\xf6lugildi"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "gildi"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "n\xfamer"\x2C\n        array: "fylki"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Rangt gildi: \xde\xfa sl\xf3st inn ${received} \xfear sem \xe1 a\xf0 vera instanceof ${issue.expected}`;\n                }\n                return `Rangt gildi: \xde\xfa sl\xf3st inn ${received} \xfear sem \xe1 a\xf0 vera ${expected}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Rangt gildi: gert r\xe1\xf0 fyrir ${util.stringifyPrimitive(issue.values[0])}`;\n                return `\xd3gilt val: m\xe1 vera eitt af eftirfarandi ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `Of st\xf3rt: gert er r\xe1\xf0 fyrir a\xf0 ${issue.origin ?? "gildi"} hafi ${adj}${issue.maximum.toString()} ${sizing.unit ?? "hluti"}`;\n                return `Of st\xf3rt: gert er r\xe1\xf0 fyrir a\xf0 ${issue.origin ?? "gildi"} s\xe9 ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `Of l\xedti\xf0: gert er r\xe1\xf0 fyrir a\xf0 ${issue.origin} hafi ${adj}${issue.minimum.toString()} ${sizing.unit}`;\n                }\n                return `Of l\xedti\xf0: gert er r\xe1\xf0 fyrir a\xf0 ${issue.origin} s\xe9 ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with") {\n                    return `\xd3gildur strengur: ver\xf0ur a\xf0 byrja \xe1 "${_issue.prefix}"`;\n                }\n                if (_issue.format === "ends_with")\n                    return `\xd3gildur strengur: ver\xf0ur a\xf0 enda \xe1 "${_issue.suffix}"`;\n                if (_issue.format === "includes")\n                    return `\xd3gildur strengur: ver\xf0ur a\xf0 innihalda "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `\xd3gildur strengur: ver\xf0ur a\xf0 fylgja mynstri ${_issue.pattern}`;\n                return `Rangt ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `R\xf6ng tala: ver\xf0ur a\xf0 vera margfeldi af ${issue.divisor}`;\n            case "unrecognized_keys":\n                return `\xd3\xfeekkt ${issue.keys.length > 1 ? "ir lyklar" : "ur lykill"}: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `Rangur lykill \xed ${issue.origin}`;\n            case "invalid_union":\n                return "Rangt gildi";\n            case "invalid_element":\n                return `Rangt gildi \xed ${issue.origin}`;\n            default:\n                return `Rangt gildi`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
