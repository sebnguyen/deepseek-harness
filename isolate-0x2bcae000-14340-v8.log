script-source,238,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/session/session-projection/lib/index.js,import { Service } from "@deepseek-ai/cordis";\nimport { SessionLogOffset\x2C SessionSeq } from "@deepseek-ai/dsh-session";\n//#region lib/types/index.js\n/**\n* Service Definition and drive registry for the session-projection capability seam: the merge-extensible state and client-view type\n* tables\x2C the `ProjectionDefinition` state-driven computation unit contract\x2C\n* and the `ctx.sessionProjections` registry that DRIVES every registered unit\n* forward eagerly over committed session events. Domain host plugins\n* contribute pure folds and optional client views; the framework owns the\n* subscription\x2C the per-session watermark cache\x2C and change notification;\n* carriers consume the snapshot read face and the change feed. Neither side\n* knows the other\n* (capability-seam three-way split). Design authority: the session-projection\n* RFC (.agents/notes/proposed/architecture/2026-07-27-session-projection-and-command-log.md).\n*\n* Whole-value event rule (load-bearing): a state-carrying log event MUST\n* carry the complete post-change state\x2C never a bare delta \u2014 it keeps every\n* unit's transition trivially cheap and every served value self-describing.\n*\n* @module @deepseek-ai/dsh-session-projection\n*/\n/** Convert a log offset to the inclusive cursor immediately before it. */\nfunction cursorBefore(offset) {\n\x09return offset === 0 ? -1 : SessionSeq(offset - 1);\n}\n/**\n* `ctx.sessionProjections`: the projection unit table and its drive. The\n* service subscribes to `session/event` once; every committed event passes\n* every registered unit's `apply` (eager drive). A changed state reference\n* computes the next client view; the change feed is notified only when its\n* raw result changes by `Object.is`.\n* Cells build lazily \u2014 a unit registered after events flowed\x2C or a session\n* older than the registry\x2C folds `init` over the in-memory log on first\n* touch (event or read). Registration is an effect (disposer rides the\n* calling fiber): an unloaded domain plugin's key disappears from snapshots\n* and clients read it as capability absence. A host reader either declares\n* `sessionProjections` in its plugin `inject` or fails explicitly when the\n* registry or required key is absent. Contributors may preserve optional\n* registration through `ctx.inject(['sessionProjections']\x2C ...)`. Registrants sharing a key\n* share one unit and are counted: the same tool package mounted in N agent\n* presets registers N times\x2C and the key survives until the last one\n* unloads.\n*/\nvar SessionProjectionRegistry = class extends Service {\n\x09registrations = /* @__PURE__ */ new Map();\n\x09listeners = /* @__PURE__ */ new Set();\n\x09/**\n\x09* Create and install the registry as `ctx.sessionProjections`.\n\x09* @param ctx - Cordis context that owns the service.\n\x09*/\n\x09constructor(ctx) {\n\x09\x09super(ctx\x2C "sessionProjections");\n\x09\x09ctx.on("session/created"\x2C (session) => {\n\x09\x09\x09if (session.seq !== 0) return;\n\x09\x09\x09for (const registration of this.registrations.values()) {\n\x09\x09\x09\x09if (registration.cells.has(session)) continue;\n\x09\x09\x09\x09registration.cells.set(session\x2C {\n\x09\x09\x09\x09\x09state: registration.def.init(session.header\x2C session.inheritedEventCount)\x2C\n\x09\x09\x09\x09\x09observedSeq: -1\x2C\n\x09\x09\x09\x09\x09views: [void 0\x2C void 0]\n\x09\x09\x09\x09});\n\x09\x09\x09}\n\x09\x09});\n\x09\x09ctx.on("session/event"\x2C (session\x2C event) => {\n\x09\x09\x09this.drive(session\x2C event);\n\x09\x09});\n\x09}\n\x09register(definition) {\n\x09\x09const wire = definition.wire;\n\x09\x09const erased = {\n\x09\x09\x09key: definition.key\x2C\n\x09\x09\x09stateSchema: definition.stateSchema\x2C\n\x09\x09\x09init: (header\x2C inheritedEventCount) => definition.init(header\x2C inheritedEventCount)\x2C\n\x09\x09\x09apply