risticTokens: 0\x2C\n\x09\x09imageStructuralTokens: 0\x2C\n\x09\x09fileStructuralTokens: 0\x2C\n\x09\x09images: []\x2C\n\x09\x09files: []\n\x09};\n\x09const heuristicTokens = estimateMessage(message);\n\x09const images = [];\n\x09const files = [];\n\x09const structural = collectProjectedAttachments(message.content\x2C images\x2C files);\n\x09return {\n\x09\x09seq\x2C\n\x09\x09heuristicTokens\x2C\n\x09\x09imageStructuralTokens: structural.imageTokens\x2C\n\x09\x09fileStructuralTokens: structural.fileTokens\x2C\n\x09\x09images\x2C\n\x09\x09files\n\x09};\n}\n/**\n* Validate and price one surface event without mutating the surface.\n* @param nodes - the priced surface preceding this event\x2C in model-visible order.\n* @param event - the surface event to place.\n* @returns the plan for {@link commitSurfaceTokens}.\n* @throws when a replacement names a range absent from `nodes` \u2014 committed\n*   logs are surface-validated at append time\x2C so an unresolvable range is log\n*   corruption and must fail loud rather than skip the event.\n*/\nfunction planSurfaceTokens(nodes\x2C event) {\n\x09const node = analyzeNode(event.seq\x2C deriveEventMessage$1(event));\n\x09const tokens = node.heuristicTokens;\n\x09const op = event.surfaceOp;\n\x09if (op === "append") return {\n\x09\x09tokens\x2C\n\x09\x09deltaTokens: tokens\x2C\n\x09\x09node\x2C\n\x09\x09target: "append"\n\x09};\n\x09const startIdx = nodes.findIndex((candidate) => candidate.seq === op.startSeq);\n\x09const endIdx = nodes.findIndex((candidate) => candidate.seq === op.endSeq);\n\x09if (startIdx === -1 || endIdx === -1 || startIdx > endIdx) throw new Error(`token surface: replace at seq ${event.seq} has invalid current range ${op.startSeq}-${op.endSeq}`);\n\x09return {\n\x09\x09tokens\x2C\n\x09\x09deltaTokens: tokens - nodes.slice(startIdx\x2C endIdx + 1).reduce((total\x2C candidate) => total + candidate.heuristicTokens\x2C 0)\x2C\n\x09\x09node\x2C\n\x09\x09target: {\n\x09\x09\x09startIdx\x2C\n\x09\x09\x09endIdx\n\