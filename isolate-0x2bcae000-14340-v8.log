script-source,222,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/core/agent/lib/index.js,import { Service\x2C getTraceable\x2C symbols } from "@deepseek-ai/cordis";\nimport { AsyncLocalStorage } from "node:async_hooks";\nimport { isPromise } from "node:util/types";\nimport { scopeTarget } from "@deepseek-ai/dsh-scope";\nimport { boundContextSummary\x2C createUserMessage } from "@deepseek-ai/dsh-llm";\n//#region lib/types/consumed-work.js\n/**\n* How one agent log accounts for the work it consumed.\n*\n* The turn and step vocabulary alone cannot answer this. A turn that stops\n* before its first step leaves a `turn/end` shaped exactly like the balanced\n* no-op turns a rejection or an empty claim produces\x2C so reading turns in\n* isolation either credits cut-short work as finished or convicts every no-op.\n* The missing fact is the inbox's own record: {@link Inbox} logs each mutation\n* with `removedCount` and marks a cancellation `outcome: 'canceled'`\x2C which\n* separates a turn claiming its input from work being dropped unrun.\n*\n* @module @deepseek-ai/dsh-agent/consumed-work\n*/\n/**\n* Whether a turn that consumed input but never reached a step ends in a way\n* that accounts for that input. Only a `completed` end does not: it had\n* nothing left to run once its claim was rewritten away. A `blocked` end is\n* that input's ending too \u2014 the pre-step rejection that produced it discarded\n* the claimed messages\x2C so the work it took will never run.\n* @param reason - the turn's recorded ending.\n* @returns whether the ending accounts for the input the turn took.\n*/\nfunction accountsForClaim(reason) {\n\x09switch (reason.kind) {\n\x09\x09case "completed": return false;\n\x09\x09case "blocked":\n\x09\x09case "aborted":\n\x09\x09case "interrupted":\n\x09\x09case "error": return true;\n\x09\x09/* v8 ignore next 4 -- unreachable: the one unnamed built-in\x2C `max-tokens`\x2C requires a step\x2C\n\x09\x09* so its turn short-circuits as stepped before this call\x2C and `TurnEndReasonMap` is\n\x09\x09* merge-extensible\x2C so a backend-added variant cannot be listed; an unnameable ending over\n\x09\x09* consumed input must not read as success. */\n\x09\x09default: return true;\n\x09}\n}\n/**\n* Fold one agent log\x2C or an owned suffix of one\x2C into its account of consumed\n* work. Single pass\x2C and every input is the log itself: no caller has to sample\n* live state before cancelling\x2C so a cancellation issued by anyone \u2014 the owner's\n* teardown\x2C an ancestor's interrupt\x2C an unloading plugin \u2014 reads the same.\n* @param events - the log\x2C or an owned suffix\x2C to fold.\n* @returns the accounting turn when one closed\x2C and whether work was dropped unrun after it.\n*/\nfunction foldConsumedWork(events) {\n\x09const stepped = /* @__PURE__ */ new Set();\n\x09const claimed = /* @__PURE__ */ new Set();\n\x09let open;\n\x09let end;\n\x09let droppedUnrun = false;\n\x09for (const event of events) switch (event.type) {\n\x09\x09case "turn/start":\n\x09\x09\x09open = event.data.turn;\n\x09\x09\x09break;\n\x09\x09case "step/start":\n\x09\x09\x09stepped.add(event.data.turn);\n\x09\x09\x09break;\n\x09\x09case "agent/inbox/spliced": {\n\x09\x09\x09const { removedCount\x2C outcome\x2C inserted } = event.data;\n\x09\x09\x09if (removedCount === void 0) break;\n\x09\x09\x09if (outcome === "canceled") droppedUnrun ||= inserted.length === 0;\n\x09\x09\x09else if (open !== void 0) claimed.add(open);\n\x09\x09\x09break;\n\x09\x09}\n\x09\x09case "turn/end": {\n\x09\x09\x09const { turn\x2C reason } = event.data;\n\x09\x09\x09open = void 0;\n\x09\x09\x09if (stepped.delete(turn) || claimed.delete(turn) && accountsForClaim(reason)) {\n\x09\x09\x09\x09end = event;\n\x09\x09\x09\x09droppedUnrun = false;\n\x09\x09\x09}\n\x09\x09\x09break;\n\x09\x09}\n\x09\x09default: break;\n\x09}\n\x09return {\n\x09\x09...end === void 0 ? {} : { end }\x2C\n\x09\x09droppedUnrun\n\x09};\n}\n//#endregion\n//#region lib/types/model-selection.js\n/**\n* Agent-scoped model selection shared by runtime entry points.\n* @module @deepseek-ai/dsh-agent/model-selection\n*/\nfunction sameRoute(left\x2C right) {\n\x09return left.provider === right.provider && left.model === right.model;\n}\nfunction routeLabel(route\x2C other) {\n\x09return route.provider === other.provider ? route.model : `${route.provider}/${route.model}`;\n}\nfunction modelSwitchNotice(previous\x2C selected) {\n\x09const from = routeLabel(previous\x2C selected);\n\x09const to = routeLabel(selected\x2C previous);\n\x09return createUserMessage({\n\x09\x09content: [{\n\x09\x09\x09type: "text"\x2C\n\x09\x09\x09text: `[model changed: assistant turns above this point were generated by ${from}; the session continues with ${to}]`\n\x09\x09}]\x2C\n\x09\x09source: {\n\x09\x09\x09kind: "plugin"\x2C\n\x09\x09\x09plugin: "model-selection"\x2C\n\x09\x09\x09form: "notice"\x2C\n\x09\x09\x09summary: boundContextSummary(`${from} \u2192 ${to}`)\n\x09\x09}\n\x09});\n}\n/**\n* Couple one mutable selection to Agent-scoped prompt assembly and request routing.\n* Prompt assembly snapshots the selected model before delegating\x2C then applies\n* its provider/model pair and effort to request config so a\n* concurrent switch takes effect on a later step instead of splitting the two\n* surfaces. An absent selected effort clears any inherited effort\x2C restoring\n* the selected model's provider/default behavior.\n*\n* A provider/model change appends a durable user-role notice to the next\n* admitted request. It compares the assembled selection with the latest\n* request header; effort-only changes and empty no-request decisions add no\n* notice. Failure before header persistence repeats the notice on the next\n* request.\n*\n* @param agentCtx - The selected Agent's scoped context.\n* @param selection - Mutable selection owned by the calling entry point.\n* @returns Disposer for all scoped waterfall listeners.\n*/\nfunction installModelSelection(agentCtx\x2C selection) {\n\x09const disposeAssembly = agentCtx.on("system-prompt/assemble"\x2C async (_assembly\x2C _context\x2C next) => {\n\x09\x09const selected = selection.current;\n\x09\x09const assembled = await next();\n\x09\x09selection.assembled = selected;\n\x09\x09if (selected === void 0) return assembled;\n\x09\x09return {\n\x09\x09\x09...assembled\x2C\n\x09\x09\x09variables: {\n\x09\x09\x09\x09...assembled.variables\x2C\n\x09\x09\x09\x09provider: selected.provider\x2C\n\x09\x09\x09\x09model: selected.model\n\x09\x09\x09}\n\x09\x09};\n\x09});\n\x09const disposeRequest = agentCtx.on("agent/request"\x2C async (_payload\x2C next) => {\n\x09\x09const resolved = await next();\n\x09\x09const selected = selection.assembled;\n\x09\x09if (selected === void 0) return resolved;\n\x09\x09const { reasoningEffort: _inheritedEffort\x2C ...withoutInheritedEffort } = resolved;\n\x09\x09return {\n\x09\x09\x09...withoutInheritedEffort\x2C\n\x09\x09\x09provider: selected.provider\x2C\n\x09\x09\x09model: selected.model\x2C\n\x09\x09\x09...selected.reasoningEffort === void 0 ? {} : { reasoningEffort: selected.reasoningEffort }\x2C\n\x09\x09\x09...selected.temperature === void 0 ? {} : { temperature: selected.temperature }\n\x09\x09};\n\x09});\n\x09const disposeNotice = agentCtx.on("agent/pre-step"\x2C async ({ agent\x2C messages\x2C signal\x2C step }\x2C next) => {\n\x09\x09const decision = await next();\n\x09\x09if (decision.kind === "reject" || signal.aborted) return decision;\n\x09\x09if (decision.messages.length === 0 && (step === 1 || messages.length > 0)) return decision;\n\x09\x09const selected = selection.assembled;\n\x09\x09const previous = agent.session.requestHeader()?.config;\n\x09\x09if (selected === void 0 || previous === void 0 || sameRoute(selected\x2C previous)) return decision;\n\x09\x09return {\n\x09\x09\x09...decision\x2C\n\x09\x09\x09messages: [...decision.messages\x2C modelSwitchNotice(previous\x2C selected)]\n\x09\x09};\n\x09}\x2C { prepend: true });\n\x09return () => {\n\x09\x09disposeAssembly();\n\x09\x09disposeRequest();\n\x09\x09disposeNotice();\n\x09};\n}\n//#endregion\n//#region lib/types/dispatch.js\n/**\n* Agent-scoped dispatch and prompt assembly helpers. The fused dispatcher\n* {@link agentEvents} couples the agent subject to its scope carrier\x2C so the\n* scope key and the payload's `agent` cannot diverge; repeat dispatchers (the\n* loop driver) build it once in the agent's constructor and reuse it.\n* @module @deepseek-ai/dsh-agent/dispatch\n*/\n/**\n* Build the fused scope carrier for one agent subject.\n*\n* The carrier is a stateless routing object. {@link agentEvents} accepts an\n* existing carrier\x2C so callers that dispatch repeatedly for the same agent\n* (the loop driver) build it once in the agent's constructor and reuse it\x2C\n* keeping hot-path dispatches allocation-free.\n* @param agent - the subject agent and scope key.\n* @returns the carrier passed as the event dispatcher `this` value.\n*/\nfunction agentCarrier(agent) {\n\x09return scopeTarget(agent\x2C agent);\n}\n/**\n* Build a dispatcher that couples the agent subject to its scope carrier.\n* @param ctx - the context to dispatch through (any context of the app).\n* @param agent - the subject agent; also the scope-carrier key.\n* @param carrier - the scope carrier to dispatch through; defaults to\n* {@link agentCarrier} for the agent. Pass a constructor-built carrier to\n* avoid rebuilding it for every dispatch.\n* @returns the fused dispatcher.\n*/\nfunction agentEvents(ctx\x2C agent\x2C carrier = agentCarrier(agent)) {\n\x09const fused = (payload) => ({\n\x09\x09...payload\x2C\n\x09\x09agent\n\x09});\n\x09return {\n\x09\x09emit(name\x2C payload) {\n\x09\x09\x09const args = [\n\x09\x09\x09\x09carrier\x2C\n\x09\x09\x09\x09name\x2C\n\x09\x09\x09\x09fused(payload)\n\x09\x09\x09];\n\x09\x09\x09const callbacks = ctx.events.dispatch("emit"\x2C args);\n\x09\x09\x09for (const callback of callbacks) try {\n\x09\x09\x09\x09const returned = callback(...args);\n\x09\x09\x09\x09Promise.resolve(returned).catch((error) => {\n\x09\x09\x09\x09\x09ctx.logger.warn(`agent event "${name}" listener rejected: ${String(error)}`);\n\x09\x09\x09\x09});\n\x09\x09\x09} catch (error) {\n\x09\x09\x09\x09ctx.logger.warn(`agent event "${name}" listener threw: ${String(error)}`);\n\x09\x09\x09}\n\x09\x09}\x2C\n\x09\x09async serial(name\x2C payload) {\n\x09\x09\x09const serial = ctx.serial;\n\x09\x09\x09return await serial(carrier\x2C name\x2C fused(payload));\n\x09\x09}\x2C\n\x09\x09waterfall(name\x2C payload\x2C ...rest) {\n\x09\x09\x09const waterfall = ctx.waterfall;\n\x09\x09\x09return waterfall(carrier\x2C name\x2C fused(payload)\x2C ...rest);\n\x09\x09}\n\x09};\n}\n/**\n* Emit one contained agent notification without allocating a retained dispatcher.\n* @param ctx - the context to dispatch through.\n* @param agent - the subject agent and scope key.\n* @param name - the agent-subject event to emit.\n* @param payload - the event's payload fields; `agent` is injected.\n*/\nfunction emitAgentEvent(ctx\x2C agent\x2C name\x2C payload) {\n\x09agentEvents(ctx\x2C agent).emit(name\x2C payload);\n}\n/**\n* Build the prompt assembly context with agent and scope set together\x2C so\n* agent-scoped prompt and tool contributions cannot be silently omitted.\n* @param agent - the agent the assembly is for.\n* @param signal - the current turn's explicit control signal\x2C when assembly belongs to a turn.\n* @returns the context to pass to `assemble()`.\n*/\nfunction assembleContextFor(agent\x2C signal) {\n\x09return {\n\x09\x09agent\x2C\n\x09\x09scope: agent\x2C\n\x09\x09...signal === void 0 ? {} : { signal }\n\x09};\n}\n//#endregion\n//#region lib/types/index.js\n/**\n* Agent service: live registry\x2C factory delegation\x2C and process-local\n* initiator scope. Concrete creation and driving belong to the loop.\n*\n* @module @deepseek-ai/dsh-agent\n*/\n/** Thrown when create/resume is called before an agent factory is registered. */\nconst NO_FACTORY_MESSAGE = "no agent factory registered (load an agent-loop plugin)";\nconst NO_INITIATOR_MESSAGE = "no initiating agent is active";\nconst DISPOSED_INITIATOR_MESSAGE = "agent initiator scope is disposed";\n/**\n* Agent service (`ctx.agents`): tracks live agents and carries the initiating\n* Agent through one process-local asynchronous driver chain. Agent *creation*\n* is provided by whichever plugin implements the {@link AgentFactory}\n* (`@deepseek-ai/dsh-agent-loop`)\x2C registered via {@link setFactory}.\n*\n* Initiator methods provide same-process causal attribution only. Ambient\n* presence is neither liveness proof nor authorization; subjects and owners\n* remain explicit\x2C as does identity at worker\x2C process\x2C persistence\x2C and wire\n* boundaries. Returned Promise boundaries drain during teardown\x2C except a\n* nested lineage that starts an owning-fiber unload is excluded from its own drain.\n*/\nvar AgentRegistry = class extends Service {\n\x09store = /* @__PURE__ */ new Map();\n\x09factory;\n\x09initiators = new AsyncLocalStorage();\n\x09initiatorRuns = new AsyncLocalStorage();\n\x09initiatorState = "active";\n\x09activeInitiatorRuns = 0;\n\x09initiatorDrain;\n\x09initiatorDisposal;\n\x09constructor(ctx) {\n\x09\x09super(ctx\x2C "agents");\n\x09\x09ctx.inject(["typert"]\x2C (typeCtx) => {\n\x09\x09\x09typeCtx.typert.lookups.register("agent"\x2C {\n\x09\x09\x09\x09parameter: "agent"\x2C\n\x09\x09\x09\x09wire: "agentId"\x2C\n\x09\x09\x09\x09hostTypeSymbol: "@deepseek-ai/dsh-agent#Agent"\x2C\n\x09\x09\x09\x09wireTypeSymbol: "@deepseek-ai/dsh-session/types#SessionId"\x2C\n\x09\x09\x09\x09resolve: (sessionId) => this.get(sessionId)\n\x09\x09\x09});\n\x09\x09\x09typeCtx.typert.contexts.registerHost("agent"\x2C {\n\x09\x09\x09\x09wire: "agentId"\x2C\n\x09\x09\x09\x09wireTypeSymbol: "@deepseek-ai/dsh-session/types#SessionId"\x2C\n\x09\x09\x09\x09resolve: (sessionId) => this.get(sessionId)?.ctx\n\x09\x09\x09});\n\x09\x09});\n\x09\x09ctx.on("internal/status"\x2C (fiber) => {\n\x09\x09\x09if (fiber.state === 5 && this.hasLifecycleAncestor(fiber)) this.closeInitiators();\n\x09\x09});\n\x09\x09ctx.effect(function* () {\n\x09\x09\x09yield () => this.disposeInitiators();\n\x09\x09\x09yield () => {\n\x09\x09\x09\x09this.closeInitiators();\n\x09\x09\x09};\n\x09\x09}.bind(this)\x2C "agents.initiatorLifecycle()");\n\x09}\n\x09/**\n\x09* Read the Agent that initiated the inherited asynchronous driver chain.\n\x09* Use this optional form for logging\x2C tracing\x2C metrics\x2C or host attribution\n\x09* that also supports agentless calls. When a parent creates a child\x2C setup\n\x09* reports the causal parent while the setup callback's Agent parameter\n\x09* identifies the child.\n\x09* @returns the inherited Agent\x2C or `undefined` outside an initiator boundary\n\x09*   and inside an explicit clearing boundary.\n\x09* @throws when this service instance has been disposed.\n\x09*/\n\x09currentInitiator() {\n\x09\x09this.assertInitiatorsReadable();\n\x09\x09return this.initiators.getStore();\n\x09}\n\x09/**\n\x09* Read the initiating Agent and fail when no initiator boundary is active.\n\x09* Use this for private helpers contractually below a driver\x2C or for a\n\x09* deployment-owned outbound request whose contract forbids agentless calls.\n\x09* Generic or direct-call paths use optional lookup or explicit request fields.\n\x09* @returns the inherited Agent.\n\x09* @throws when no initiator is active or this service instance has been disposed.\n\x09*/\n\x09requireInitiator() {\n\x09\x09const agent = this.currentInitiator();\n\x09\x09if (agent === void 0) throw new Error(NO_INITIATOR_MESSAGE);\n\x09\x09return agent;\n\x09}\n\x09/**\n\x09* Run an operation with one exact Agent as its process-local initiator. The\n\x09* exact synchronous value or Promise returned by the operation is preserved.\n\x09* Custom drivers and test harnesses wrap their complete returned foreground\n\x09* lifetime.\n\x09* A queue or wire receiver may establish this boundary only after validating\n\x09* explicit identity and resolving the exact live Agent; this method does neither.\n\x09* Detached work remains owned by the subsystem that starts it.\n\x09* @param agent - initiating Agent to inherit; presence is neither liveness proof nor authorization.\n\x09* @param operation - synchronous or asynchronous operation to invoke.\n\x09* @returns the exact value returned by `operation`.\n\x09* @throws when the initiator scope is closing/disposed\x2C or when `operation` throws.\n\x09*/\n\x09withInitiator(agent\x2C operation) {\n\x09\x09return this.runWithInitiator(agent\x2C operation);\n\x09}\n\x09/**\n\x09* Run an operation inside a boundary that hides any inherited initiating\n\x09* Agent. The exact synchronous value or Promise is preserved.\n\x09* Use this while creating lazy shared timers\x2C queue pumps\x2C pool maintenance\x2C\n\x09* watchers\x2C or exporters so they do not inherit the first Agent that happens\n\x09* to initialize them. It clears only initiator attribution\x2C not explicit\n\x09* fields\x2C and does not own or drain detached resources.\n\x09* @param operation - synchronous or asynchronous operation to invoke without an initiator.\n\x09* @returns the exact value returned by `operation`.\n\x09* @throws when the initiator scope is closing/disposed\x2C or when `operation` throws.\n\x09*/\n\x09withoutInitiator(operation) {\n\x09\x09return this.runWithInitiator(void 0\x2C operation);\n\x09}\n\x09/**\n\x09* Register the agent-creation factory (the loop calls this on construction\x2C\n\x09* effect-scoped). A traced Cordis service is canonicalized to its concrete\n\x09* target; each create/resume call is then traced through that caller's\n\x09* context so ownership follows the caller without stacking proxy layers.\n\x09* Throws if a factory is already registered. Returns the disposer; on\n\x09* dispose the factory slot is cleared.\n\x09* @param factory - the loop-owned factory {@link create}/{@link res