script-source,174,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod/v4/locales/hy.js,import * as util from "../core/util.js";\nfunction getArmenianPlural(count\x2C one\x2C many) {\n    return Math.abs(count) === 1 ? one : many;\n}\nfunction withDefiniteArticle(word) {\n    if (!word)\n        return "";\n    const vowels = ["\u0561"\x2C "\u0565"\x2C "\u0568"\x2C "\u056b"\x2C "\u0578"\x2C "\u0578\u0582"\x2C "\u0585"];\n    const lastChar = word[word.length - 1];\n    return word + (vowels.includes(lastChar) ? "\u0576" : "\u0568");\n}\nconst error = () => {\n    const Sizable = {\n        string: {\n            unit: {\n                one: "\u0576\u0577\u0561\u0576"\x2C\n                many: "\u0576\u0577\u0561\u0576\u0576\u0565\u0580"\x2C\n            }\x2C\n            verb: "\u0578\u0582\u0576\u0565\u0576\u0561\u056c"\x2C\n        }\x2C\n        file: {\n            unit: {\n                one: "\u0562\u0561\u0575\u0569"\x2C\n                many: "\u0562\u0561\u0575\u0569\u0565\u0580"\x2C\n            }\x2C\n            verb: "\u0578\u0582\u0576\u0565\u0576\u0561\u056c"\x2C\n        }\x2C\n        array: {\n            unit: {\n                one: "\u057f\u0561\u0580\u0580"\x2C\n                many: "\u057f\u0561\u0580\u0580\u0565\u0580"\x2C\n            }\x2C\n            verb: "\u0578\u0582\u0576\u0565\u0576\u0561\u056c"\x2C\n        }\x2C\n        set: {\n            unit: {\n                one: "\u057f\u0561\u0580\u0580"\x2C\n                many: "\u057f\u0561\u0580\u0580\u0565\u0580"\x2C\n            }\x2C\n            verb: "\u0578\u0582\u0576\u0565\u0576\u0561\u056c"\x2C\n        }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "\u0574\u0578\u0582\u057f\u0584"\x2C\n        email: "\u0567\u056c. \u0570\u0561\u057d\u0581\u0565"\x2C\n        url: "URL"\x2C\n        emoji: "\u0567\u0574\u0578\u057b\u056b"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "ISO \u0561\u0574\u057d\u0561\u0569\u056b\u057e \u0587 \u056a\u0561\u0574"\x2C\n        date: "ISO \u0561\u0574\u057d\u0561\u0569\u056b\u057e"\x2C\n        time: "ISO \u056a\u0561\u0574"\x2C\n        duration: "ISO \u057f\u0587\u0578\u0572\u0578\u0582\u0569\u0575\u0578\u0582\u0576"\x2C\n        ipv4: "IPv4 \u0570\u0561\u057d\u0581\u0565"\x2C\n        ipv6: "IPv6 \u0570\u0561\u057d\u0581\u0565"\x2C\n        cidrv4: "IPv4 \u0574\u056b\u057b\u0561\u056f\u0561\u0575\u0584"\x2C\n        cidrv6: "IPv6 \u0574\u056b\u057b\u0561\u056f\u0561\u0575\u0584"\x2C\n        base64: "base64 \u0571\u0587\u0561\u0579\u0561\u0583\u0578\u057e \u057f\u0578\u0572"\x2C\n        base64url: "base64url \u0571\u0587\u0561\u0579\u0561\u0583\u0578\u057e \u057f\u0578\u0572"\x2C\n        json_string: "JSON \u057f\u0578\u0572"\x2C\n        e164: "E.164 \u0570\u0561\u0574\u0561\u0580"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "\u0574\u0578\u0582\u057f\u0584"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "\u0569\u056b\u057e"\x2C\n        array: "\u0566\u0561\u0576\u0563\u057e\u0561\u056e"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `\u054d\u056d\u0561\u056c \u0574\u0578\u0582\u057f\u0584\u0561\u0563\u0580\u0578\u0582\u0574\u2024 \u057d\u057a\u0561\u057d\u057e\u0578\u0582\u0574 \u0567\u0580 instanceof ${issue.expected}\x2C \u057d\u057f\u0561\u0581\u057e\u0565\u056c \u0567 ${received}`;\n                }\n                return `\u054d\u056d\u0561\u056c \u0574\u0578\u0582\u057f\u0584\u0561\u0563\u0580\u0578\u0582\u0574\u2024 \u057d\u057a\u0561\u057d\u057e\u0578\u0582\u0574 \u0567\u0580 ${expected}\x2C \u057d\u057f\u0561\u0581\u057e\u0565\u056c \u0567 ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `\u054d\u056d\u0561\u056c \u0574\u0578\u0582\u057f\u0584\u0561\u0563\u0580\u0578\u0582\u0574\u2024 \u057d\u057a\u0561\u057d\u057e\u0578\u0582\u0574 \u0567\u0580 ${util.stringifyPrimitive(issue.values[1])}`;\n                return `\u054d\u056d\u0561\u056c \u057f\u0561\u0580\u0562\u0565\u0580\u0561\u056f\u2024 \u057d\u057a\u0561\u057d\u057e\u0578\u0582\u0574 \u0567\u0580 \u0570\u0565\u057f\u0587\u0575\u0561\u056c\u0576\u0565\u0580\u056b\u0581 \u0574\u0565\u056f\u0568\u055d ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    const maxValue = Number(issue.maximum);\n                    const unit = getArmenianPlural(maxValue\x2C sizing.unit.one\x2C sizing.unit.many);\n                    return `\u0549\u0561\u0583\u0561\u0566\u0561\u0576\u0581 \u0574\u0565\u056e \u0561\u0580\u056a\u0565\u0584\u2024 \u057d\u057a\u0561\u057d\u057e\u0578\u0582\u0574 \u0567\x2C \u0578\u0580 ${withDefiniteArticle(issue.origin ?? "\u0561\u0580\u056a\u0565\u0584")} \u056f\u0578\u0582\u0576\u0565\u0576\u0561 ${adj}${issue.maximum.toString()} ${unit}`;\n                }\n                return `\u0549\u0561\u0583\u0561\u0566\u0561\u0576\u0581 \u0574\u0565\u056e \u0561\u0580\u056a\u0565\u0584\u2024 \u057d\u057a\u0561\u057d\u057e\u0578\u0582\u0574 \u0567\x2C \u0578\u0580 ${withDefiniteArticle(issue.origin ?? "\u0561\u0580\u056a\u0565\u0584")} \u056c\u056b\u0576\u056b ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    const minValue = Number(issue.minimum);\n                    const unit = getArmenianPlural(minValue\x2C sizing.unit.one\x2C sizing.unit.many);\n                    return `\u0549\u0561\u0583\u0561\u0566\u0561\u0576\u0581 \u0583\u0578\u0584\u0580 \u0561\u0580\u056a\u0565\u0584\u2024 \u057d\u057a\u0561\u057d\u057e\u0578\u0582\u0574 \u0567\x2C \u0578\u0580 ${withDefiniteArticle(issue.origin)} \u056f\u0578\u0582\u0576\u0565\u0576\u0561 ${adj}${issue.minimum.toString()} ${unit}`;\n                }\n                return `\u0549\u0561\u0583\u0561\u0566\u0561\u0576\u0581 \u0583\u0578\u0584\u0580 \u0561\u0580\u056a\u0565\u0584\u2024 \u057d\u057a\u0561\u057d\u057e\u0578\u0582\u0574 \u0567\x2C \u0578\u0580 ${withDefiniteArticle(issue.origin)} \u056c\u056b\u0576\u056b ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `\u054d\u056d\u0561\u056c \u057f\u0578\u0572\u2024 \u057a\u0565\u057f\u0584 \u0567 \u057d\u056f\u057d\u057e\u056b "${_issue.prefix}"-\u0578\u057e`;\n                if (_issue.format === "ends_with")\n                    return `\u054d\u056d\u0561\u056c \u057f\u0578\u0572\u2024 \u057a\u0565\u057f\u0584 \u0567 \u0561\u057e\u0561\u0580\u057f\u057e\u056b "${_issue.suffix}"-\u0578\u057e`;\n                if (_issue.format === "includes")\n                    return `\u054d\u056d\u0561\u056c \u057f\u0578\u0572\u2024 \u057a\u0565\u057f\u0584 \u0567 \u057a\u0561\u0580\u0578\u0582\u0576\u0561\u056f\u056b "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `\u054d\u056d\u0561\u056c \u057f\u0578\u0572\u2024 \u057a\u0565\u057f\u0584 \u0567 \u0570\u0561\u0574\u0561\u057a\u0561\u057f\u0561\u057d\u056d\u0561\u0576\u056b ${_issue.pattern} \u0571\u0587\u0561\u0579\u0561\u0583\u056b\u0576`;\n                return `\u054d\u056d\u0561\u056c ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `\u054d\u056d\u0561\u056c \u0569\u056b\u057e\u2024 \u057a\u0565\u057f\u0584 \u0567 \u0562\u0561\u0566\u0574\u0561\u057a\u0561\u057f\u056b\u056f \u056c\u056b\u0576\u056b ${issue.divisor}-\u056b`;\n            case "unrecognized_keys":\n                return `\u0549\u0573\u0561\u0576\u0561\u0579\u057e\u0561\u056e \u0562\u0561\u0576\u0561\u056c\u056b${issue.keys.length > 1 ? "\u0576\u0565\u0580" : ""}. ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `\u054d\u056d\u0561\u056c \u0562\u0561\u0576\u0561\u056c\u056b ${withDefiniteArticle(issue.origin)}-\u0578\u0582\u0574`;\n            case "invalid_union":\n                return "\u054d\u056d\u0561\u056c \u0574\u0578\u0582\u057f\u0584\u0561\u0563\u0580\u0578\u0582\u0574";\n            case "invalid_element":\n                return `\u054d\u056d\u0561\u056c \u0561\u0580\u056a\u0565\u0584 ${withDefiniteArticle(issue.origin)}-\u0578\u0582\u0574`;\n            default:\n                return `\u054d\u056d\u0561\u056c \u0574\u0578\u0582\u057f\u0584\u0561\u0563\u0580\u0578\u0582\u0574`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
