script-source,234,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/session/session-persistence/lib/index.js,import { Service } from "@deepseek-ai/cordis";\nimport { KNOWN_SESSION_EVENT_TYPES\x2C SESSION_FORMAT_VERSION\x2C adoptSessionEvent } from "@deepseek-ai/dsh-session";\nimport { snapshotJsonValue } from "@deepseek-ai/dsh-util-values";\n//#region lib/types/revision.js\n/** Opaque revision identity for lightweight persistence observations. */\n/**\n* Brand a backend revision for the provider-neutral persistence contract.\n* @param value - backend-owned opaque revision representation.\n* @returns the same runtime string with persistence-revision identity.\n*/\nfunction SessionPersistenceRevision(value) {\n\x09return value;\n}\n//#endregion\n//#region lib/types/errors.js\n/**\n* Stable failures exposed by the session-persistence service and its handles\x2C\n* including the format refusals shared by every backend: a stored log this\n* build cannot faithfully interpret is refused\x2C never misread\x2C and the\n* refusal points at the raw artifact when the backend keeps one per session.\n* @module @deepseek-ai/dsh-session-persistence/errors\n*/\n/** The requested Session identity has no durable log visible to this caller. */\nvar SessionPersistenceNotFoundError = class extends Error {\n\x09sessionId;\n\x09/** @param sessionId - absent durable Session identity. */\n\x09constructor(sessionId) {\n\x09\x09super(`session "${sessionId}" not found`);\n\x09\x09this.sessionId = sessionId;\n\x09\x09this.name = "SessionPersistenceNotFoundError";\n\x09}\n};\n/** `create` targeted a Session identity that already exists in this backend. */\nvar SessionAlreadyExistsError = class extends Error {\n\x09sessionId;\n\x09/** @param sessionId - the occupied durable Session identity. */\n\x09constructor(sessionId) {\n\x09\x09super(`session "${sessionId}" already exists`);\n\x09\x09this.sessionId = sessionId;\n\x09\x09this.name = "SessionAlreadyExistsError";\n\x09}\n};\n/** A write open found the session already bound to an active write handle. */\nvar SessionAlreadyOwnedError = class extends Error {\n\x09sessionId;\n\x09/** @param sessionId - the session whose write ownership is taken. */\n\x09constructor(sessionId) {\n\x09\x09super(`session "${sessionId}" is already owned by an active write handle`);\n\x09\x09this.sessionId = sessionId;\n\x09\x09this.name = "SessionAlreadyOwnedError";\n\x09}\n};\n/** A mutation (`append`/`flush`) was called on a read handle. */\nvar SessionReadOnlyError = class extends Error {\n\x09sessionId;\n\x09/**\n\x09* @param sessionId - the session the read handle observes.\n\x09* @param operation - the refused mutating operation name.\n\x09*/\n\x09constructor(sessionId\x2C operation) {\n\x09\x09super(`session "${sessionId}": ${operation} is not available on a read handle`);\n\x09\x09this.sessionId = sessionId;\n\x09\x09this.name = "SessionReadOnlyError";\n\x09}\n};\n/**\n* A write handle's ownership is permanently gone: its lease expired\x2C a renewal\n* failed\x2C or the durable ownership record no longer names this handle. The\n* handle never re-acquires ownership \u2014 close it and reopen for write.\n*\n* Declared for the cross-process lease layer; the shipped in-process backends\n* never throw it yet.\n*/\nvar SessionOwnershipLostError = class extends Error {\n\x09sessionId;\n\x09/** @param sessionId - the session whose write ownership this handle lost. */\n\x09constructor(sessionId) {\n\x09\x09super(`session "${sessionId}": write ownership was lost; close this handle and reopen`);\n\x09\x09this.sessionId = sessionId;\n\x09\x09this.name = "SessionOwnershipLostError";\n\x09}\n};\n/** An operation was called on a handle after `close()` was called. */\nvar SessionHandleClosedError = class extends Error {\n\x09sessionId;\n\x09/**\n\x09* @param sessionId - the session the closed handle addressed.\n\x09* @param operation - the refused operation name.\n\x09*/\n\x09constructor(sessionId\x2C operation) {\n\x09\x09super(`session "${sessionId}": ${operation} on a closed handle`);\n\x09\x09this.sessionId = sessionId;\n\x09\x09this.name = "SessionHandleClosedError";\n\x09}\n};\n/** Durable session contents failed validation after a successful backend read. */\nvar SessionPersistenceCorruptionError = class extends Error {\n\x09/**\n\x09* @param message - stable corruption context.\n\x09* @param options - original validation failure.\n\x09*/\n\x09constructor(message\x2C options) {\n\x09\x09super(message\x2C options);\n\x09\x09this.name = "SessionPersistenceCorruptionError";\n\x09}\n};\n/**\n* The stored log is intact but this runtime cannot faithfully interpret it:\n* the header carries an unsupported format version\x2C or an event's type is\n* unknown to this build. Distinct from {@link SessionPersistenceCorruptionError}\n* \u2014 nothing is damaged; the raw log remains readable at {@link location} when\n* the backend keeps one artifact per session.\n*/\nvar SessionFormatUnsupportedError = class extends Error {\n\x09location;\n\x09/**\n\x09* @param message - stable reason the log cannot be interpreted\x2C already\n\x09*   including the raw-log path when one exists.\n\x09* @param location - the backend's artifact location\x2C when one exists.\n\x09*/\n\x09constructor(message\x2C location) {\n\x09\x09super(message);\n\x09\x09this.location = location;\n\x09\x09this.name = "SessionFormatUnsupportedError";\n\x09}\n};\n/**\n* Direction-aware refusal text for a stored session whose format version this\n* build does not read. Shared by load-time checks and by backends that must\n* refuse BEFORE decoding version-dependent structure (a future format may not\n* satisfy this build's structural checks at all\x2C and the user must see\n* "upgrade the harness"\x2C never "corrupt").\n* @param id - the stored session id\x2C for message context.\n* @param version - the stored format version.\n* @returns the stable refusal text\x2C without a raw-log path suffix.\n*/\nfunction sessionFormatVersionRefusal(id\x2C version) {\n\x09return version > SESSION_FORMAT_VERSION ? `session "${id}" uses log format v${version}\x2C but this harness reads only v${SESSION_FORMAT_VERSION}: the log was written by a newer harness \u2014 upgrade the harness to open it` : `session "${id}" uses log format v${version}\x2C older than the supported v${SESSION_FORMAT_VERSION}\x2C and this build ships no upgrade path for it`;\n}\n//#endregion\n//#region lib/types/storage-contract.js\n/**\n* Backend-shared storage validation: the version gate\x2C the fail-closed event\n* vocabulary\x2C append-batch materialization\x2C and contiguity \u2014 one place so\n* every backend refuses the same inputs identically.\n* @module @deepseek-ai/dsh-session-persistence/storage-contract\n*/\n/** Build a format refusal that points at the raw artifact when the backend has one. */\nfunction unsupported(reason\x2C location) {\n\x09return new SessionFormatUnsupportedError(location === void 0 ? reason : `${reason} (raw log: ${location.path})`\x2C location);\n}\n/**\n* Refuse stored metadata that is not bound to the requested session id.\n* @param id - the requested session id.\n* @param meta - the stored header.\n*/\nfunction assertStoredId(id\x2C meta) {\n\x09if (meta.id !== id) throw new Error(`stored session identity mismatch: requested "${id}"\x2C header contains "${meta.id}"`);\n}\n/**\n* Refuse a header that has not been restored to the current logical format.\n* @param meta - the stored header.\n* @param location - the backend's artifact location for the refusal\x2C when one exists.\n*/\nfunction assertVersion(meta\x2C location) {\n\x09if (meta.version !== SESSION_FORMAT_VERSION) throw unsupported(sessionFormatVersionRefusal(meta.id\x2C meta.version)\x2C location);\n}\n/**\n* Validate one exclusively owned stored event array in place: adopt each\n* record (validating and freezing it) and refuse any event type this build\n* does not know\x2C unless its writer marked it `ignorable: true` \u2014 silently\n* skipping an unknown required event could reconstruct a wrong session (the\n* envelope contract on `SessionEvent.ignorable`). Unknown required types and\n* retired pre-release shapes refuse here; this validator performs no migration.\n* @param meta - the stored header the events belong to.\n* @param events - exclusively owned decoded events; validated in place.\n* @param location - the backend's artifact location for refusals\x2C when one exists.\n* @returns the same array\x2C validated and frozen.\n* @throws {SessionFormatUnsupportedError} for unknown event types.\n* @throws {SessionPersistenceCorruptionError} for records that fail validation.\n*/\nfunction validateStoredEvents(meta\x2C events\x2C location) {\n\x09for (const event of events) {\n\x09\x09if (!KNOWN_SESSION_EVENT_TYPES.has(event.type) && event.ignorable !== true) throw unsupported(`session "${meta.id}" contains event type "${event.type}" (seq ${event.seq}) unknown to this harness and not marked ignorable; refusing to interpret the log \u2014 it was likely written by a newer harness`\x2C location);\n\x09\x09if (event.type === "request/header") {\n\x09\x09\x09const data = event.data;\n\x09\x09\x09if (typeof data === "object" && data !== null && data["reason"] === "fallback") throw unsupported(`session "${meta.id}" contains a request/header event (seq ${event.seq}) with the unsupported legacy reason "fallback"; refusing to interpret the log \u2014 it was written by a retired pre-release harness`\x2C location);\n\x09\x09}\n\x09}\n\x09try {\n\x09\x09for (const [index\x2C event] of events.entries()) events[index] = adoptSessionEvent(event);\n\x09} catch (error) {\n\x09\x09if (error instanceof SessionFormatUnsupportedError) throw error;\n\x09\x09throw new SessionPersistenceCorruptionError(`stored session "${meta.id}" failed validation: ${String(error)}`\x2C { cause: error });\n\x09}\n\x09return events;\n}\n/**\n* Validate and deep-snapshot a header passed to `create` in one traversal.\n* @param header - the caller's header.\n* @returns the detached lossless-JSON header.\n* @throws {TypeError} for non-JSON metadata or an invalid `createdAt`.\n*/\nfunction materializeCreateHeader(header) {\n\x09const snapshot = snapshotJsonValue(header);\n\x09if (snapshot === void 0) throw new TypeError("session metadata must be losslessly JSON-serializable");\n\x09if (!Number.isSafeInteger(snapshot.createdAt) || snapshot.createdAt < 0) throw new TypeError("session metadata createdAt must be a non-negative safe integer");\n\x09return snapshot;\n}\n/**\n* Validate and deep-snapshot one append batch in a single traversal\x2C so the\n* checked value is exactly the value persisted (a check followed by a copy\n* could reread accessors into a different record).\n* @param events - the caller's batch.\n* @returns the detached lossless-JSON batch.\n* @throws {TypeError} when any event data is not losslessly JSON-serializable.\n*/\nfunction materializeAppendBatch(events) {\n\x09const batch = snapshotJsonValue(events);\n\x09if (batch === void 0) throw new TypeError("session event batch is not losslessly JSON-serializable because it contains non-JSON-serializable data");\n\x09return batch;\n}\n/**\n* Refuse a batch that does not contiguously continue the stored log.\n* @param id - the session the batch belongs to.\n* @param events - the batch\x2C in seq order.\n* @param cursor - the stored next-seq.\n*/\nfunction assertContiguous(id\x2C events\x2C cursor) {\n\x09for (const [index\x2C event] of events.entries()) if (event.seq !== cursor + index) throw new Error(`append seq mismatch for "${id}": expected ${cursor + index} at index ${index}\x2C got ${event.seq}`);\n}\n//#endregion\n//#region lib/types/index.js\n/**\n* Durable session-persistence Service Definition (`ctx.sessionPersistence`). Backends store\n* {@link SessionEvent}s as the event-sourced log and carry non-replayable\n* {@link SessionHeader} metadata separately; callers address one stored\n* session through a {@link SessionHandle} obtained from `create`/`open`.\n* @module @deepseek-ai/dsh-session-persistence\n*/\n/**\n* Durable append-only session storage addressed through per-session handles.\n*\n* Storage semantics shared by every backend: events are contiguous from seq 0\n* and never rewritten; a torn physical tail is never returned to a reader and\n* is truncated by the write path before its first append; reads validate\n* current-format records only and refuse unknown vocabulary fail-closed.\n* `append` persists best-effort; `flush` \u2014 per handle or service-wide \u2014 is\n* the durability barrier.\n*\n* Visibility: a created session is observable through `stat`/`list`/`open`\n* in this process from the moment `create` resolves\x2C even while a backend\n* defers physical materialization (a pure optimization); other processes see\n* the session only once it materializes\x2C and a session that never\n* materialized before a crash never existed. `SessionHandle.flush` forces\n* materialization.\n*\n* Freshness: once an `append` or `flush` resolves\x2C reads started afterwards\n* on this backend instance observe at least that prefix.\n*/\nvar SessionPersistence = class extends Service {\n\x09constructor(ctx) {\n\x09\x09super(ctx\x2C "sessionPersistence");\n\x09}\n};\n//#endregion\nexport { SessionAlreadyExistsError\x2C SessionAlreadyOwnedError\x2C SessionFormatUnsupportedError\x2C SessionHandleClosedError\x2C SessionOwnershipLostError\x2C SessionPersistence\x2C SessionPersistence as default\x2C SessionPersistenceCorruptionError\x2C SessionPersistenceNotFoundError\x2C SessionPersistenceRevision\x2C SessionReadOnlyError\x2C assertContiguous\x2C assertStoredId\x2C assertVersion\x2C materializeAppendBatch\x2C materializeCreateHeader\x2C sessionFormatVersionRefusal\x2C validateStoredEvents };\n
