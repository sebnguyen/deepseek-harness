...this.layers.global.toolProviders.values()\x2C ...scopeLayers.flatMap((layer) => [...layer.toolProviders.values()])];\n\x09\x09const knownNames = /* @__PURE__ */ new Set();\n\x09\x09for (const provider of providers) {\n\x09\x09\x09const result = provider(context);\n\x09\x09\x09const acceptedKnownNames = result.knownNames ?? result.schemas.map((tool) => tool.name);\n\x09\x09\x09for (const name of acceptedKnownNames) knownNames.add(name);\n\x09\x09}\n\x09\x09return knownNames;\n\x09}\n\x09/**\n\x09* Register an ordered prompt section in the calling context's scope. A scoped\n\x09* section shadows a global section with the same name; duplicates within one\n\x09* layer and non-finite orders throw. Registration and disposal emit\n\x09* `system-prompt/change`.\n\x09* @param section - the section to register.\n\x09* @returns the exact Cordis effect disposer.\n\x09*/\n\x09section(section) {\n\x09\x09if (!Number.isFinite(section.order)) throw new TypeError(`prompt section "${section.name}" order must be a finite number`);\n\x09\x09return this.layers.effect(this.ctx\x2C (layer) => layer.sections.insert(section.name\x2C section)\x2C { label: "systemPrompt.section()" });\n\x09}\n\x09/**\n\x09* Resolve the centrally owned placement of a repository prompt section.\n\x09* @param name - stable section placement name.\n\x09* @returns the section's numeric sort order.\n\x09*/\n\x09getSectionOrder(name) {\n\x09\x09return SECTION_ORDERS[name];\n\x09}\n\x09/**\n\x09* Resolve the centrally owned placement of a repository runtime context.\n\x09* @param name - stable context placement name.\n\x09* @returns the context's numeric sort order.\n\x09*/\n\x09getContextOrder(name) {\n\x09\x09return CONTEXT_ORDERS[name];\n\x09}\n\x09/**\n\x09* Register ordered dynamic context in the calling context's scope. Scoped\n\x09* entries shadow global entries with the same name.\n\x09* @param context - the context contribution to register.\n\x09* @returns the exact Cordis effect disposer.\n\x09*/\n\x09co