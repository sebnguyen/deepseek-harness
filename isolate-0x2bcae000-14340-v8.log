x09\x09\x09stamp\n\x09\x09\x09\x09\x09};\n\x09\x09\x09\x09} catch (error) {\n\x09\x09\x09\x09\x09this.standing.delete(preset.id);\n\x09\x09\x09\x09\x09await scope.dispose();\n\x09\x09\x09\x09\x09throw error;\n\x09\x09\x09\x09}\n\x09\x09\x09})();\n\x09\x09\x09this.standing.set(preset.id\x2C created);\n\x09\x09\x09return created;\n\x09\x09}\n\x09};\n})();\n/** Read one composition file's stamp\x2C or undefined when it cannot be statted. */\nasync function compositionStamp(path) {\n\x09try {\n\x09\x09const { mtimeMs\x2C size } = await stat(path);\n\x09\x09return {\n\x09\x09\x09mtimeMs\x2C\n\x09\x09\x09size\n\x09\x09};\n\x09} catch {\n\x09\x09return;\n\x09}\n}\n/** Whether two stamps name the same file state. */\nfunction sameStamp(a\x2C b) {\n\x09return a.mtimeMs === b.mtimeMs && a.size === b.size;\n}\n//#endregion\nexport { AgentPresetSettingsSchema\x2C AgentPresets\x2C AgentPresets as default\x2C COMPOSITION_FILE\x2C METADATA_FILE\x2C SETTINGS_NAMESPACE\x2C SHIPPED_PRESET_ROOT\x2C agentPresetProjectionDefinition\x2C copyComposition\x2C deleteComposition\x2C discoverPresets\x2C inactiveRows\x2C leakedServices\x2C livePresetMounts\x2C mountPreset\x2C readComposition\x2C readPresetMetadata\x2C renderPresetMetadata\x2C scanRoot\x2C serviceForAgent\x2C standingMountFor\x2C writableRoot };\n
