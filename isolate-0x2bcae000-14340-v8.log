e.expected)) {\n                    return `Ung\xfcltige Eingabe: erwartet instanceof ${issue.expected}\x2C erhalten ${received}`;\n                }\n                return `Ung\xfcltige Eingabe: erwartet ${expected}\x2C erhalten ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Ung\xfcltige Eingabe: erwartet ${util.stringifyPrimitive(issue.values[0])}`;\n                return `Ung\xfcltige Option: erwartet eine von ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `Zu gro\xdf: erwartet\x2C dass ${issue.origin ?? "Wert"} ${adj}${issue.maximum.toString()} ${sizing.unit ?? "Elemente"} hat`;\n                return `Zu gro\xdf: erwartet\x2C dass ${issue.origin ?? "Wert"} ${adj}${issue.maximum.toString()} ist`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `Zu klein: erwartet\x2C dass ${issue.origin} ${adj}${issue.minimum.toString()} ${sizing.unit} hat`;\n                }\n                return `Zu klein: erwartet\x2C dass ${issue.origin} ${adj}${issue.minimum.toString()} ist`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `Ung\xfcltiger String: muss mit "${_issue.prefix}" beginnen`;\n                if (_issue.format === "ends_with")\n                    return `Ung\xfcltiger String: muss mit "${_issue.suffix}" enden`;\n                if (_issue.format === "includes")\n                    return `Ung\xfcltiger String: muss "${_issue.includes}" enthalten`;\n                if (_issue