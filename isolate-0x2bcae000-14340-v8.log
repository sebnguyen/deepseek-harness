script-source,191,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod/v4/locales/pt.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "caracteres"\x2C verb: "ter" }\x2C\n        file: { unit: "bytes"\x2C verb: "ter" }\x2C\n        array: { unit: "itens"\x2C verb: "ter" }\x2C\n        set: { unit: "itens"\x2C verb: "ter" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "padr\xe3o"\x2C\n        email: "endere\xe7o de e-mail"\x2C\n        url: "URL"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "data e hora ISO"\x2C\n        date: "data ISO"\x2C\n        time: "hora ISO"\x2C\n        duration: "dura\xe7\xe3o ISO"\x2C\n        ipv4: "endere\xe7o IPv4"\x2C\n        ipv6: "endere\xe7o IPv6"\x2C\n        cidrv4: "faixa de IPv4"\x2C\n        cidrv6: "faixa de IPv6"\x2C\n        base64: "texto codificado em base64"\x2C\n        base64url: "URL codificada em base64"\x2C\n        json_string: "texto JSON"\x2C\n        e164: "n\xfamero E.164"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "entrada"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "n\xfamero"\x2C\n        null: "nulo"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Tipo inv\xe1lido: esperado instanceof ${issue.expected}\x2C recebido ${received}`;\n                }\n                return `Tipo inv\xe1lido: esperado ${expected}\x2C recebido ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Entrada inv\xe1lida: esperado ${util.stringifyPrimitive(issue.values[0])}`;\n                return `Op\xe7\xe3o inv\xe1lida: esperada uma das ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `Muito grande: esperado que ${issue.origin ?? "valor"} tivesse ${adj}${issue.maximum.toString()} ${sizing.unit ?? "elementos"}`;\n                return `Muito grande: esperado que ${issue.origin ?? "valor"} fosse ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `Muito pequeno: esperado que ${issue.origin} tivesse ${adj}${issue.minimum.toString()} ${sizing.unit}`;\n                }\n                return `Muito pequeno: esperado que ${issue.origin} fosse ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `Texto inv\xe1lido: deve come\xe7ar com "${_issue.prefix}"`;\n                if (_issue.format === "ends_with")\n                    return `Texto inv\xe1lido: deve terminar com "${_issue.suffix}"`;\n                if (_issue.format === "includes")\n                    return `Texto inv\xe1lido: deve incluir "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `Texto inv\xe1lido: deve corresponder ao padr\xe3o ${_issue.pattern}`;\n                return `${FormatDictionary[_issue.format] ?? issue.format} inv\xe1lido`;\n            }\n            case "not_multiple_of":\n                return `N\xfamero inv\xe1lido: deve ser m\xfaltiplo de ${issue.divisor}`;\n            case "unrecognized_keys":\n                return `Chave${issue.keys.length > 1 ? "s" : ""} desconhecida${issue.keys.length > 1 ? "s" : ""}: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `Chave inv\xe1lida em ${issue.origin}`;\n            case "invalid_union":\n                return "Entrada inv\xe1lida";\n            case "invalid_element":\n                return `Valor inv\xe1lido em ${issue.origin}`;\n            default:\n                return `Campo inv\xe1lido`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
