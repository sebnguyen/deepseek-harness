ovider)\x2C { label: "systemPrompt.variable()" });\n\x09}\n\x09/**\n\x09* Assemble global and scoped providers\x2C detach tool parameters\x2C apply\n\x09* canonical ordering\x2C then run the assembly waterfall. Scoped sections and\n\x09* variables shadow globals. The returned waterfall value is authoritative\n\x09* except that an effective complete section is restored afterwards as the\n\x09* sole prompt section.\n\x09* @param context - the optional scope and plugin-defined assembly fields.\n\x09* @returns the post-waterfall assembly with any complete prompt enforced.\n\x09*/\n\x09async assemble(context = {}) {\n\x09\x09const scope = context.scope;\n\x09\x09const scopeLayers = this.layers.chainLayers(scope);\n\x09\x09const runtimeContextSuppressed = !this.layers.global.runtimeContextSuppressors.isEmpty() || scopeLayers.some((layer) => !layer.runtimeContextSuppressors.isEmpty());\n\x09\x09const variables = {};\n\x09\x09for (const [name\x2C provider] of this.layers.global.variables.entries()) variables[name] = provider(context);\n\x09\x09for (const layer of scopeLayers) for (const [name\x2C provider] of layer.variables.entries()) variables[name] = provider(context);\n\x09\x09const sectionByName = this.layers.merge(scope\x2C (layer) => layer.sections);\n\x09\x09const contextByName = this.layers.merge(scope\x2C (layer) => layer.contexts);\n\x09\x09const providerResults = [...this.layers.global.toolProviders.values()\x2C ...scopeLayers.flatMap((layer) => [...layer.toolProviders.values()])].map((provider) => provider(context));\n\x09\x09const knownNames = /* @__PURE__ */ new Set();\n\x09\x09const collected = [];\n\x09\x09for (const result of providerResults) {\n\x09\x09\x09const acceptedKnownNames = result.knownNames ?? result.schemas.map((tool) => tool.name);\n\x09\x09\x09for (const name of acceptedKnownNames) knownNames.add(name);\n\x09\x09\x09collected.push(...result.schemas.map(({ name\x2C description\x2C parameters }) => ({\n\x09\x09\x09\x09name\x2C\n\x09\x09\x09\x09