script-source,239,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/preset/agent-presets/lib/index.js,import { isBuiltin } from "node:module";\nimport { chmod\x2C cp\x2C readFile\x2C readdir\x2C rm\x2C stat } from "node:fs/promises";\nimport { evaluate\x2C isJsExpr } from "@deepseek-ai/cordis-plugin-loader";\nimport z from "@deepseek-ai/schemastery";\nimport { Remote\x2C RemoteError\x2C TypertRemoteService } from "@deepseek-ai/dsh-typert-protocol";\nimport { bindScopeParent\x2C createScope\x2C scopeOf\x2C scopeParentOf } from "@deepseek-ai/dsh-scope";\nimport { dshHomePath\x2C expandHomePath } from "@deepseek-ai/dsh-home-paths";\nimport { existsSync } from "node:fs";\nimport { dirname\x2C isAbsolute\x2C join\x2C resolve } from "node:path";\nimport { fileURLToPath\x2C pathToFileURL } from "node:url";\nimport yaml\x2C { load } from "js-yaml";\nimport { Include\x2C entryListSchema } from "@deepseek-ai/cordis-plugin-include";\nimport { writeFileAtomic } from "@deepseek-ai/dsh-atomic-write";\nimport { Context } from "@deepseek-ai/cordis";\nimport { z as z$1 } from "zod";\n//#region lib/types/metadata.js\n/**\n* A preset's display metadata: the name and description a picker shows.\n*\n* It lives in its own file because the composition is a top-level list of\n* plugin rows \u2014 YAML cannot carry sibling keys beside it\x2C and faking a\n* metadata row would hand the Loader something to load. Keeping it separate\n* also keeps the composition exactly what its name says: a Cordis file the\n* loader owns and the cordis preset can author.\n*\n* The file carries display text ONLY. `id` is the directory name and `trust`\n* comes from the root a preset was discovered under\x2C so neither is writable\n* here \u2014 otherwise a locally authored preset could claim to be a shipped one.\n*\n* Every read failure degrades to no metadata. A preset whose display text is\n* missing\x2C malformed\x2C or unreadable still mounts: presentation is not a\n* capability\x2C and a broken name must never become an agent that cannot start.\n* @module @deepseek-ai/dsh-agent-presets/metadata\n*/\n/** The optional display-metadata file beside a preset's composition. */\nconst METADATA_FILE = "preset.yml";\n/** A non-empty trimmed string\x2C or undefined for anything else. */\nfunction text(value) {\n\x09if (typeof value !== "string") return void 0;\n\x09const trimmed = value.trim();\n\x09return trimmed === "" ? void 0 : trimmed;\n}\n/**\n* Read one preset directory's display metadata.\n*\n* Absent\x2C unparsable\x2C and wrongly-shaped files are all the same answer \u2014\n* empty metadata \u2014 because the caller renders a picker\x2C not a diagnostic.\n* @param directory - the preset directory.\n* @returns the display text the preset published\x2C possibly empty.\n*/\nasync function readPresetMetadata(directory) {\n\x09let raw;\n\x09try {\n\x09\x09raw = await readFile(join(directory\x2C METADATA_FILE)\x2C "utf8");\n\x09} catch {\n\x09\x09return {};\n\x09}\n\x09let parsed;\n\x09try {\n\x09\x09parsed = yaml.load(raw);\n\x09} catch {\n\x09\x09return {};\n\x09}\n\x09if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) return {};\n\x09const record = parsed;\n\x09const name = text(record.name);\n\x09const description = text(record.description);\n\x09const order = typeof record.order === "number" && Number.isFinite(record.order) ? record.order : void 0;\n\x09return {\n\x09\x09...name === void 0 ? {} : { name }\x2C\n\x09\x09...description === void 0 ? {} : { description }\x2C\n\x09\x09...order === void 0 ? {} : { order }\n\x09};\n}\n/**\n* Render display metadata as the file's contents.\n*\n* Absent fields are omitted rather than written empty\x2C so a preset with no\n* description does not ship a key that reads as an intentional blank.\n* @param metadata - the display text to store.\n* @returns the YAML document\x2C or undefined when there is nothing to store.\n*/\nfunction renderPresetMetadata(metadata) {\n\x09const name = text(metadata.name);\n\x09const description = text(metadata.description);\n\x09const { order } = metadata;\n\x09if (name === void 0 && description === void 0 && order === void 0) return void 0;\n\x09return yaml.dump({\n\x09\x09...name === void 0 ? {} : { name }\x2C\n\x09\x09...description === void 0 ? {} : { description }\x2C\n\x09\x09...order === void 0 ? {} : { order }\n\x09}\x2C { lineWidth: -1 });\n}\n//#endregion\n//#region lib/types/preset.js\n/** Agent-preset vocabulary shared by discovery\x2C mounting\x2C and consumers. */\n/**\n* Ids a preset directory may use.\n*\n* The id becomes a path segment\x2C so this is a containment boundary rather than\n* a style rule: `..`\x2C a separator\x2C or an absolute-looking name would place the\n* composition outside the root the deployment authorised. Discovery shares it:\n* a directory whose name no copy could ever claim is not a preset slot.\n*/\nconst PRESET_ID = /^[a-z0-9][a-z0-9-]*$/;\n//#endregion\n//#region lib/types/specifier.js\n/**\n* How one composition row's `name` reaches a module.\n*\n* A preset composition is read by `Include`\x2C which rewrites its context's\n* `baseUrl` to the composition's own directory. That is right for a row\n* naming a file the preset ships and wrong for a row naming a package: a\n* locally authored preset lives under the user's home\x2C where Node's upward\n* `node_modules` walk never reaches the harness's own dependencies. Both the\n* mount's import override and discovery's health check therefore have to\n* classify a row's name before they can act on it\x2C and they must classify it\n* the same way \u2014 a row discovery resolves from one base and the mount imports\n* from another would be reported healthy and then fail to load.\n* @module @deepseek-ai/dsh-agent-presets/specifier\n*/\n/**\n* Classify one row's `name`.\n*\n* An absolute filesystem path becomes a file URL here rather than at each\n* call site\x2C because Node's ESM resolver rejects a bare drive-letter path on\n* Windows