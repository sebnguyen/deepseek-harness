script-source,281,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/session/session-stats/lib/index.js,import z from "@deepseek-ai/schemastery";\nimport { z as z$1 } from "zod";\nimport { assistantStreamFirstTokenTime } from "@deepseek-ai/dsh-llm";\nimport { Remote\x2C TypertRemoteService } from "@deepseek-ai/dsh-typert-protocol";\n//#region lib/types/cost-projection.js\n/**\n* The `sessionCost` projection unit: whole-log provider token usage priced\n* under deployment-declared per-million rates. Each session folds its own\n* log\x2C so a child subagent session carries its own spend and the client's\n* per-scope projection read yields per-agent cost without any cross-session\n* scan.\n*\n* The fold reads exactly the provider buckets the `tokenUsage` fold reads \u2014\n* `usage.inputTokens` is the uncached prompt remainder (adapters subtract\n* cache counters from it)\x2C so the four buckets map one-to-one onto the four\n* configured rates. Micro dollars per token equal the per-million rate\x2C so\n* the accumulation is exact integer-friendly arithmetic with one round at\n* the end. Beside the whole-log totals the fold keeps one spend entry per\n* provider-logged model (`perModel`)\x2C so a client can list WHERE the spend\n* went without rescanning the log.\n*\n* @module @deepseek-ai/dsh-session-stats/cost-projection\n*/\n/** One model's four rates on the wire. */\nconst modelRatesSchema = z$1.object({\n\x09inputPerMillionUsd: z$1.number().nonnegative()\x2C\n\x09outputPerMillionUsd: z$1.number().nonnegative()\x2C\n\x09cacheReadPerMillionUsd: z$1.number().nonnegative()\x2C\n\x09cacheWritePerMillionUsd: z$1.number().nonnegative()\n}).strict();\n/** One model's folded spend on the wire. */\nconst modelSpendSchema = z$1.object({\n\x09uncachedInputTokens: z$1.number().int().nonnegative()\x2C\n\x09outputTokens: z$1.number().int().nonnegative()\x2C\n\x09cacheReadTokens: z$1.number().int().nonnegative()\x2C\n\x09cacheWriteTokens: z$1.number().int().nonnegat