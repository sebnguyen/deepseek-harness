script-source,289,node:internal/navigator,'use strict';\n\nconst {\n  ObjectDefineProperties\x2C\n  ObjectFreeze\x2C\n  StringPrototypeIndexOf\x2C\n  StringPrototypeSlice\x2C\n  StringPrototypeToUpperCase\x2C\n  Symbol\x2C\n} = primordials;\n\nconst {\n  ERR_ILLEGAL_CONSTRUCTOR\x2C\n} = require('internal/errors').codes;\n\nconst {\n  kEnumerableProperty\x2C\n} = require('internal/util');\n\nconst {\n  getAvailableParallelism\x2C\n} = internalBinding('os');\n\nconst kInitialize = Symbol('kInitialize');\n\nconst {\n  platform\x2C\n  arch\x2C\n  version: nodeVersion\x2C\n} = require('internal/process/per_thread');\n\nconst {\n  getDefaultLocale\x2C\n} = internalBinding('config');\n\n/**\n * @param {string} arch\n * @param {string} platform\n * @returns {string}\n */\nfunction getNavigatorPlatform(arch\x2C platform) {\n  if (platform === 'darwin') {\n    // On macOS\x2C modern browsers return 'MacIntel' even if running on Apple Silicon.\n    return 'MacIntel';\n  } else if (platform === 'win32') {\n    // On Windows\x2C modern browsers return 'Win32' even if running on a 64-bit version of Windows.\n    // https://developer.mozilla.org/en-US/docs/Web/API/Navigator/platform#usage_notes\n    return 'Win32';\n  } else if (platform === 'linux') {\n    if (arch === 'ia32') {\n      return 'Linux i686';\n    } else if (arch === 'x64') {\n      return 'Linux x86_64';\n    }\n    return `Linux ${arch}`;\n  } else if (platform === 'freebsd') {\n    if (arch === 'ia32') {\n      return 'FreeBSD i386';\n    } else if (arch === 'x64') {\n      return 'FreeBSD amd64';\n    }\n    return `FreeBSD ${arch}`;\n  } else if (platform === 'openbsd') {\n    if (arch === 'ia32') {\n      return 'OpenBSD i386';\n    } else if (arch === 'x64') {\n      return 'OpenBSD amd64';\n    }\n    return `OpenBSD ${arch}`;\n  } else if (platform === 'sunos') {\n    if (arch === 'ia32') {\n      return 'SunOS i86pc';\n    }\n    return `SunOS ${arch}`;\n  } else if (platform === 'aix') {\n    return 'AIX';\n  }\n  return `${StringPrototypeToUpperCase(platform[0])}${StringPrototypeSlice(platform\x2C 1)} ${arch}`;\n}\n\nclass Navigator {\n  // Private properties are used to avoid brand validations.\n  #availableParallelism;\n  #locks;\n  #userAgent;\n  #platform;\n  #languages;\n\n  constructor() {\n    if (arguments[0] === kInitialize) {\n      return;\n    }\n    throw new ERR_ILLEGAL_CONSTRUCTOR();\n  }\n\n  /**\n   * @returns {number}\n   */\n  get hardwareConcurrency() {\n    this.#availableParallelism ??= getAvailableParallelism();\n    return this.#availableParallelism;\n  }\n\n  /**\n   * @returns {LockManager}\n   */\n  get locks() {\n    this.#locks ??= require('internal/locks').locks;\n    return this.#locks;\n  }\n\n  /**\n   * @returns {string}\n   */\n  get language() {\n    // The default locale might be changed dynamically\x2C so always invoke the\n    // binding.\n    return getDefaultLocale() || 'en-US';\n  }\n\n  /**\n   * @returns {Array<string>}\n   */\n  get languages() {\n    this.#languages ??= ObjectFreeze([this.language]);\n    return this.#languages;\n  }\n\n  /**\n   * @returns {string}\n   */\n  get userAgent() {\n    this.#userAgent ??= `Node.js/${StringPrototypeSlice(nodeVersion\x2C 1\x2C StringPrototypeIndexOf(nodeVersion\x2C '.'))}`;\n    return this.#userAgent;\n  }\n\n  /**\n   * @returns {string}\n   */\n  get platform() {\n    this.#platform ??= getNavigatorPlatform(arch\x2C platform);\n    return this.#platform;\n  }\n}\n\nObjectDefineProperties(Navigator.prototype\x2C {\n  hardwareConcurrency: kEnumerableProperty\x2C\n  language: kEnumerableProperty\x2C\n  languages: kEnumerableProperty\x2C\n  userAgent: kEnumerableProperty\x2C\n  platform: kEnumerableProperty\x2C\n  locks: kEnumerableProperty\x2C\n});\n\nmodule.exports = {\n  getNavigatorPlatform\x2C\n  navigator: new Navigator(kInitialize)\x2C\n  Navigator\x2C\n};\n
