nt[registration.def.key];\n\x09\x09\x09const need = row !== void 0 && row.ver === registration.def.stateVersion ? Math.max(row.seq + 1\x2C 0) : 0;\n\x09\x09\x09floor = floor === void 0 ? need : Math.min(floor\x2C need);\n\x09\x09}\n\x09\x09return floor === void 0 ? void 0 : SessionLogOffset(Math.max(floor - 1\x2C 0));\n\x09}\n\x09/**\n\x09* View a checkpoint's rows without any log read: for every registered\n\x09* client-visible unit whose row's `ver` matches\x2C serve the schema-validated\n\x09* `view` of the schema-validated stored state; mismatched\x2C malformed\x2C or absent rows leave their key\n\x09* absent (a cold or listing consumer treats it as not-yet-available and a\n\x09* fuller read path refolds it). The zero-I/O rung of the read ladder \u2014\n\x09* values are as stale as their rows\x2C never wrong.\n\x09* @param checkpoint - persisted rows for one session (possibly stale or empty).\n\x09* @param keys - optional wire keys to view.\n\x09* @returns whole values per key with a usable row; empty when none.\n\x09*/\n\x09viewCheckpoint(checkpoint\x2C keys) {\n\x09\x09const values = {};\n\x09\x09const selected = keys === void 0 ? void 0 : new Set(keys);\n\x09\x09for (const registration of this.registrations.values()) {\n\x09\x09\x09const def = registration.def;\n\x09\x09\x09if (def.wire === void 0) continue;\n\x09\x09\x09if (selected !== void 0 && !selected.has(def.key)) continue;\n\x09\x09\x09const row = checkpoint[def.key];\n\x09\x09\x09if (row === void 0 || row.ver !== def.stateVersion) continue;\n\x09\x09\x09let state;\n\x09\x09\x09try {\n\x09\x09\x09\x09state = def.stateSchema.parse(row.val);\n\x09\x09\x09} catch {\n\x09\x09\x09\x09continue;\n\x09\x09\x09}\n\x09\x09\x09values[def.key] = def.wire.viewSchema.parse(def.wire.view(state));\n\x09\x09}\n\x09\x09return values;\n\x09}\n\x09/**\n\x09* Cold read: fold every persisted unit over a stored log suffix\x2C seeding\n\x09* each from its checkpoint row when usable \u2014 the one read recipe (cached\n\x09* s