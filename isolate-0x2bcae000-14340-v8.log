script-source,256,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/util/atomic-write/lib/index.js,import { randomBytes } from "node:crypto";\nimport { lstat\x2C mkdir\x2C rename\x2C rm\x2C writeFile } from "node:fs/promises";\nimport { dirname } from "node:path";\n//#region lib/types/index.js\n/**\n* Zero-dependency atomic file replacement and writer coordination.\n* `writeFileAtomic` writes a random-suffix sibling with exclusive create and\n* the caller's permission bits\x2C then renames it over the target\x2C so readers\n* observe either the old or the new complete content and a replaced file ends\n* up with exactly the stated mode. `withFileLock` serializes cross-process\n* writers of one file through a `wx`-created `<file>.lock` sibling\x2C so a\n* read-modify-write cycle can never resurrect a state another writer just\n* replaced; readers stay lock-free because the rename commit is atomic.\n* @module @deepseek-ai/dsh-atomic-write\n*/\nconst WINDOWS_TRANSIENT_RENAME_ERRORS = new Set([\n\x09"EACCES"\x2C\n\x09"EBUSY"\x2C\n\x09"EPERM"\n]);\nconst WINDOWS_RENAME_RETRY_INITIAL_MS = 20;\nconst WINDOWS_RENAME_RETRY_MAX_MS = 200;\nconst WINDOWS_RENAME_RETRY_LIMIT = 8;\n/** Whether Windows reported temporary interference with an atomic replacement. */\nfunction isTransientWindowsRenameError(error) {\n\x09if (process.platform !== "win32") return false;\n\x09return WINDOWS_TRANSIENT_RENAME_ERRORS.has(error?.code ?? "");\n}\n/** Replace the target after bounded retries for transient Windows interference. */\nasync function renameAtomicTemp(temp\x2C filename) {\n\x09let delay = WINDOWS_RENAME_RETRY_INITIAL_MS;\n\x09for (let retries = 0;; retries += 1) {\n\x09\x09try {\n\x09\x09\x09await rename(temp\x2C filename);\n\x09\x09\x09return;\n\x09\x09} catch (error) {\n\x09\x09\x09if (!isTransientWindowsRenameError(error)) throw error;\n\x09\x09\x09if (retries >= WINDOWS_RENAME_RETRY_LIMIT) throw error;\n\x09\x09}\n\x09\x09await new Promise((resolve) => setTimeout