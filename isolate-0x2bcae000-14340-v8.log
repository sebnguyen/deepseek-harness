script-source,169,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod/v4/locales/fr.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "caract\xe8res"\x2C verb: "avoir" }\x2C\n        file: { unit: "octets"\x2C verb: "avoir" }\x2C\n        array: { unit: "\xe9l\xe9ments"\x2C verb: "avoir" }\x2C\n        set: { unit: "\xe9l\xe9ments"\x2C verb: "avoir" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "entr\xe9e"\x2C\n        email: "adresse e-mail"\x2C\n        url: "URL"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "date et heure ISO"\x2C\n        date: "date ISO"\x2C\n        time: "heure ISO"\x2C\n        duration: "dur\xe9e ISO"\x2C\n        ipv4: "adresse IPv4"\x2C\n        ipv6: "adresse IPv6"\x2C\n        cidrv4: "plage IPv4"\x2C\n        cidrv6: "plage IPv6"\x2C\n        base64: "cha\xeene encod\xe9e en base64"\x2C\n        base64url: "cha\xeene encod\xe9e en base64url"\x2C\n        json_string: "cha\xeene JSON"\x2C\n        e164: "num\xe9ro E.164"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "entr\xe9e"\x2C\n    };\n    const TypeDictionary = {\n        string: "cha\xeene"\x2C\n        number: "nombre"\x2C\n        int: "entier"\x2C\n        boolean: "bool\xe9en"\x2C\n        bigint: "grand entier"\x2C\n        symbol: "symbole"\x2C\n        undefined: "ind\xe9fini"\x2C\n        null: "null"\x2C\n        never: "jamais"\x2C\n        void: "vide"\x2C\n        date: "date"\x2C\n        array: "tableau"\x2C\n        object: "objet"\x2C\n        tuple: "tuple"\x2C\n        record: "enregistrement"\x2C\n        map: "carte"\x2C\n        set: "ensemble"\x2C\n        file: "fichier"\x2C\n        nonoptional: "non-optionnel"\x2C\n        nan: "NaN"\x2C\n        function: "fonction"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Entr\xe9e invalide : instanceof ${issue.expected} attendu\x2C ${received} re\xe7u`;\n                }\n                return `Entr\xe9e invalide : ${expected} attendu\x2C ${received} re\xe7u`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Entr\xe9e invalide : ${util.stringifyPrimitive(issue.values[0])} attendu`;\n                return `Option invalide : une valeur parmi ${util.joinValues(issue.values\x2C "|")} attendue`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `Trop grand : ${TypeDictionary[issue.origin] ?? "valeur"} doit ${sizing.verb} ${adj}${issue.maximum.toString()} ${sizing.unit ?? "\xe9l\xe9ment(s)"}`;\n                return `Trop grand : ${TypeDictionary[issue.origin] ?? "valeur"} doit \xeatre ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `Trop petit : ${TypeDictionary[issue.origin] ?? "valeur"} doit ${sizing.verb} ${adj}${issue.minimum.toString()} ${sizing.unit}`;\n                return `Trop petit : ${TypeDictionary[issue.origin] ?? "valeur"} doit \xeatre ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `Cha\xeene invalide : doit commencer par "${_issue.prefix}"`;\n                if (_issue.format === "ends_with")\n                    return `Cha\xeene invalide : doit se terminer par "${_issue.suffix}"`;\n                if (_issue.format === "includes")\n                    return `Cha\xeene invalide : doit inclure "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `Cha\xeene invalide : doit correspondre au mod\xe8le ${_issue.pattern}`;\n                return `${FormatDictionary[_issue.format] ?? issue.format} invalide`;\n            }\n            case "not_multiple_of":\n                return `Nombre invalide : doit \xeatre un multiple de ${issue.divisor}`;\n            case "unrecognized_keys":\n                return `Cl\xe9${issue.keys.length > 1 ? "s" : ""} non reconnue${issue.keys.length > 1 ? "s" : ""} : ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `Cl\xe9 invalide dans ${issue.origin}`;\n            case "invalid_union":\n                return "Entr\xe9e invalide";\n            case "invalid_element":\n                return `Valeur invalide dans ${issue.origin}`;\n            default:\n                return `Entr\xe9e invalide`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
