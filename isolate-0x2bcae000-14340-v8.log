\n\x09merge(scope\x2C pick) {\n\x09\x09const merged = new Map(pick(this.global).entries());\n\x09\x09for (const layer of this.chainLayers(scope)) for (const [name\x2C value] of pick(layer).entries()) merged.set(name\x2C value);\n\x09\x09return merged;\n\x09}\n\x09/**\n\x09* Attach one synchronous layer mutation to its registration context.\n\x09* @param ctx - context that determines both scope visibility and effect ownership.\n\x09* @param action - atomic mutation returning its synchronous undo.\n\x09* @param options - Cordis effect label and optional change notification.\n\x09* @returns the exact disposer returned by `ctx.effect()`.\n\x09*/\n\x09effect(ctx\x2C action\x2C options) {\n\x09\x09const scope = scopeOf(ctx);\n\x09\x09const notify = options.notify ?? true;\n\x09\x09return ctx.effect(function* () {\n\x09\x09\x09let layer;\n\x09\x09\x09let created = false;\n\x09\x09\x09if (scope === void 0) layer = this.global;\n\x09\x09\x09else {\n\x09\x09\x09\x09const existing = this.scoped.get(scope);\n\x09\x09\x09\x09if (existing === void 0) {\n\x09\x09\x09\x09\x09layer = this.createLayer(scope);\n\x09\x09\x09\x09\x09this.scoped.set(scope\x2C layer);\n\x09\x09\x09\x09\x09created = true;\n\x09\x09\x09\x09} else layer = existing;\n\x09\x09\x09}\n\x09\x09\x09let undo;\n\x09\x09\x09try {\n\x09\x09\x09\x09undo = action(layer);\n\x09\x09\x09} catch (error) {\n\x09\x09\x09\x09if (scope !== void 0 && created && layer.isEmpty()) this.scoped.delete(scope);\n\x09\x09\x09\x09throw error;\n\x09\x09\x09}\n\x09\x09\x09yield () => {\n\x09\x09\x09\x09undo();\n\x09\x09\x09\x09if (scope !== void 0 && layer.isEmpty()) this.scoped.delete(scope);\n\x09\x09\x09\x09if (notify) this.onChange();\n\x09\x09\x09};\n\x09\x09\x09if (notify) this.onChange();\n\x09\x09}.bind(this)\x2C options.label);\n\x09}\n};\n//#endregion\n//#region lib/types/index.js\n/**\n* Scoped-context primitive: mint a Cordis context that tags registrations with\n* an opaque identity and build routing-only event carriers for that identity.\n*\n* @module @deepseek-ai/dsh-scope\n*/\n/** Context tag written by {@link createScope}. */\nconst kScope = Symbol("dsh.scope");\n/** The key associated with each carrier. Presence distinguishes an unkeyed carrier from a non-carrier. */\nconst carrierKeys = /* @__PURE__ */ new WeakMap();\n/**\n* The enclosing scope of each key. One relation powers both directions of\n* scope nesting: registration views inherit DOWN the chain (a child scope\n* sees its ancestors' layers \u2014 {@link ScopedLayers})\x2C and event admission\n* extends UP it (a listener tagged with an ancestor receives events dispatched\n* to a descendant key \u2014 {@link scopeTarget}).\n*/\nconst scopeParents = /* @__PURE__ */ new WeakMap();\n/** Cycle-checked write shared by the bind and every rebind. */\nfunction linkScopeParent(key\x2C parent) {\n\x09for (let cursor = parent; cursor !== void 0; cursor = scopeParents.get(cursor)) if (cursor === key) throw new Error("dsh-scope: scope parent link would form a cycle");\n\x09scopeParents.set(key\x2C parent);\n}\n/**\n* Bind `parent` as `key`'s enclosing scope\x2C once.\n*\n* A key that already has a parent throws: there is no open re-link path\x2C so a\n* scope's ancestry cannot be moved by anyone but the original binder\x2C who\n* alone receives the {@link ScopeParentBinding}. A link that would close a\n* cycle is rejected\x2C because every chain consumer walks parents to the root.\n* @param key - the child scope key.\n* @param parent - its enclosing scope key.\n* @returns the binding that alone may re-link this key.\n*/\nfunction bindScopeParent(key\x2C parent) {\n\x09if (scopeParents.has(key)) throw new Error("dsh-scope: scope key is already bound to a parent; re-linking requires the binding returned by the original bind");\n\x09linkScopeParent(key\x2C parent);\n\x09return { rebind(next) {\n\x09\x09linkScopeParent(key\x2C next);\n\x09} };\n}\n/**\n* Read one key's enclosing scope.\n* @param key - the scope key to inspect.\n* @returns it