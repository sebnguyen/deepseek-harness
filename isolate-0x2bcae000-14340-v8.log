script-source,237,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/test-support/agent-loop-testkit/lib/index.js,import AgentRegistry from "@deepseek-ai/dsh-agent";\nimport AgentLoop from "@deepseek-ai/dsh-agent-loop";\nimport LlmRuntime from "@deepseek-ai/dsh-llm";\nimport SessionStore from "@deepseek-ai/dsh-session";\nimport SessionProjectionRegistry from "@deepseek-ai/dsh-session-projection";\nimport SystemPrompt from "@deepseek-ai/dsh-system-prompt";\nimport ToolRuntime from "@deepseek-ai/dsh-tools";\n//#region lib/types/inbox.js\n/**\n* Create a mutable in-memory Inbox stub for tests that exercise only the public\n* queue operations. Durable events\x2C projection validation\x2C and live Inbox\n* notifications require a real Agent created by the AgentLoop test harness.\n* @returns an Inbox backed by two process-local arrays.\n*/\nfunction createInboxStub() {\n\x09const pending = {\n\x09\x09"next-turn": []\x2C\n\x09\x09"next-step": []\n\x09};\n\x09const locate = (messageId) => {\n\x09\x09for (const target of ["next-turn"\x2C "next-step"]) {\n\x09\x09\x09const index = pending[target].findIndex((message) => message.id === messageId);\n\x09\x09\x09if (index >= 0) return {\n\x09\x09\x09\x09target\x2C\n\x09\x09\x09\x09index\n\x09\x09\x09};\n\x09\x09}\n\x09};\n\x09return {\n\x09\x09get nextTurn() {\n\x09\x09\x09return pending["next-turn"];\n\x09\x09}\x2C\n\x09\x09get nextStep() {\n\x09\x09\x09return pending["next-step"];\n\x09\x09}\x2C\n\x09\x09clear() {\n\x09\x09\x09pending["next-step"].splice(0);\n\x09\x09\x09pending["next-turn"].splice(0);\n\x09\x09}\x2C\n\x09\x09append(target\x2C message) {\n\x09\x09\x09pending[target].push(message);\n\x09\x09}\x2C\n\x09\x09prepend(target\x2C message) {\n\x09\x09\x09pending[target].unshift(message);\n\x09\x09}\x2C\n\x09\x09replace(messageId\x2C message) {\n\x09\x09\x09const location = locate(messageId);\n\x09\x09\x09if (location === void 0) return false;\n\x09\x09\x09pending[location.target].splice(location.index\x2C 1\x2C message);\n\x09\x09\x09return true;\n\x09\x09}\x2C\n\x09\x09remove(messageId) {\n\x09\x09\x09const location = locate(messageId);\n\x09\x09\x09if (location === void 0) return false;\n\x09\x09\x09pending[location.target].splice(location.index\x2C 1);\n\x09\x09\x09return true;\n\x09\x09}\x2C\n\x09\x09splice(target\x2C start\x2C deleteCount\x2C inserted) {\n\x09\x09\x09return pending[target].splice(start\x2C deleteCount\x2C ...inserted);\n\x09\x09}\n\x09};\n}\n/**\n* Create an unsupported Inbox placeholder for Agent stubs whose tests do not exercise Inbox behavior.\n* @returns an Inbox whose pending lists are empty and whose mutation methods throw.\n*/\nfunction unsupportedInbox() {\n\x09const rejectMutation = () => {\n\x09\x09throw new Error("this test Agent does not support Inbox mutations");\n\x09};\n\x09return {\n\x09\x09nextTurn: []\x2C\n\x09\x09nextStep: []\x2C\n\x09\x09clear: rejectMutation\x2C\n\x09\x09append: rejectMutation\x2C\n\x09\x09prepend: rejectMutation\x2C\n\x09\x09replace: rejectMutation\x2C\n\x09\x09remove: rejectMutation\x2C\n\x09\x09splice: rejectMutation\n\x09};\n}\n//#endregion\n//#region lib/types/index.js\n/**\n* Shared service mounting\x2C real AgentLoop drivers\x2C and structural Inbox stubs\n* for agent-loop tests. Callers retain ownership of their contexts\x2C adapters\x2C\n* optional plugins\x2C agents\x2C and teardown.\n* @module @deepseek-ai/dsh-agent-loop-testkit\n*/\n/**\n* Mount the standard prerequisite services for an AgentLoop test.\n*\n* The function deliberately does not mount AgentLoop or register an adapter\x2C\n* so tests retain control of load order and the topology under test. The\n* context owns every mounted service and remains responsible for disposal. A\n* plugin-load failure rejects the promise; services activated earlier in the\n* sequence remain context-owned and unwind with that context.\n* @param ctx - test context that owns the mounted services.\n* @param options - optional service configuration forwarded without mutation.\n* @returns after every prerequisite service has activated.\n*/\nasync function mountAgentLoopTestDependencies(ctx\x2C options = {}) {\n\x09await ctx.plugin(LlmRuntime);\n\x09await ctx.plugin(SessionStore);\n\x09await ctx.plugin(SessionProjectionRegistry);\n\x09await ctx.plugin(SystemPrompt\x2C options.systemPrompt ?? {});\n\x09await ctx.plugin(ToolRuntime\x2C options.tools ?? {});\n\x09await ctx.plugin(AgentRegistry);\n}\n/**\n* Mount the production AgentLoop and expose its narrow test-driver operations.\n* Mount {@link mountAgentLoopTestDependencies} and any load-order-sensitive\n* consumers before calling this helper. The context owns the loop and every\n* Agent returned by the harness.\n* @param ctx - test context with the AgentLoop prerequisite services active.\n* @returns a driver that creates production Agents and claims their real Inbox.\n*/\nasync function mountAgentLoopTestHarness(ctx) {\n\x09await ctx.plugin(AgentLoop\x2C { agents: [] });\n\x09return {\n\x09\x09create: async (id\x2C options = {}\x2C meta = {}) => ctx.agentLoop.create(id\x2C options\x2C meta)\x2C\n\x09\x09claim: (agent\x2C target\x2C turn) => agent.inbox.claim(target\x2C turn)\n\x09};\n}\n//#endregion\nexport { createInboxStub\x2C mountAgentLoopTestDependencies\x2C mountAgentLoopTestHarness\x2C unsupportedInbox };\n
