script-source,282,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/session/session-turn-outline/lib/index.js,import { z } from "zod";\nimport { SessionSeq } from "@deepseek-ai/dsh-session";\n//#region lib/types/projection.js\n/**\n* The `turnOutline` projection unit: a pure fold of `turn/start` boundaries\x2C\n* first human prompts\x2C and final assistant responses into the whole-log turn\n* outline the chat rail renders for turns outside a client's paged event\n* window.\n*\n* `turn/start` \u2014 not the prompt `user/message` \u2014 anchors each entry because\n* its seq is the load-through target for a jump: the loop logs `turn/start`\n* before the turn's prompt and steps\x2C so a window paged back through that seq\n* contains the whole turn. Previews mirror the rail's loaded-turn previews\n* (space-joined text blocks\x2C collapsed whitespace\x2C an ellipsis when clipped)\n* with budgets sized to the rail card's clamps \u2014 one prompt line\x2C up to three\n* response lines \u2014 so a turn shows the same words before and after its events\n* load. The response commits at `turn/end` from a draft of the newest\n* text-bearing assistant message; draft-only applies keep the `turns` array's\n* identity\x2C so the identity-gated change feed pushes at most three times per\n* turn (boundary\x2C prompt\x2C response).\n*\n* @module @deepseek-ai/dsh-session-turn-outline/projection\n*/\n/** Prompt budget: one rail-card line (13px over ~276px)\x2C ASCII worst case included. */\nconst PROMPT_PREVIEW_LIMIT = 50;\n/** Response budget: three rail-card lines (12px over ~276px). */\nconst RESPONSE_PREVIEW_LIMIT = 120;\n/** Space-join text blocks\x2C collapse whitespace\x2C and cap at `limit` with a trailing ellipsis when clipped. */\nfunction preview(content\x2C limit) {\n\x09let text = "";\n\x09let unread = false;\n\x09for (const block of content) {\n\x09\x09if (block.type !== "text") continue;\n\x09\x09if (text.length >= limit * 2) {\n\x09\x09\x09unread = true;\n\x09\x09\x09break;\n\x09\x09}\n\x09\x09const clipped = block.text.length > limit * 2;\n\x09\x09const chunk = clipped ? block.text.slice(0\x2C limit * 2) : block.text;\n\x09\x09text += text === "" ? chunk : ` ${chunk}`;\n\x09\x09if (clipped) {\n\x09\x09\x09unread = true;\n\x09\x09\x09break;\n\x09\x09}\n\x09}\n\x09const normalized = text.replace(/\\s+/g\x2C " ").trim();\n\x09if (normalized.length > limit - 1) return `${normalized.slice(0\x2C limit - 1).trimEnd()}\u2026`;\n\x09return unread ? `${normalized}\u2026` : normalized;\n}\nconst turnOutlineEntriesSchema = z.array(z.object({\n\x09turn: z.number().int().nonnegative()\x2C\n\x09seq: z.number().int().nonnegative().transform(SessionSeq)\x2C\n\x09prompt: z.string().max(PROMPT_PREVIEW_LIMIT)\x2C\n\x09response: z.string().max(RESPONSE_PREVIEW_LIMIT)\n}).strict()).superRefine((turns\x2C context) => {\n\x09let previous = -1;\n\x09for (const entry of turns) {\n\x09\x09if (entry.turn <= previous) {\n\x09\x09\x09context.addIssue({\n\x09\x09\x09\x09code: "custom"\x2C\n\x09\x09\x09\x09message: "turn outline entries must be strictly increasing by turn"\n\x09\x09\x09});\n\x09\x09\x09return;\n\x09\x09}\n\x09\x09previous = entry.turn;\n\x09}\n});\nconst turnOutlineStateSchema = z.object({\n\x09turns: turnOutlineEntriesSchema\x2C\n\x09draft: z.string().max(RESPONSE_PREVIEW_LIMIT)\n}).strict();\nconst EMPTY_OUTLINE = {\n\x09turns: []\x2C\n\x09draft: ""\n};\n/** The `turnOutline` unit registered on `ctx.sessionProjections` (exported for the unit spec). */\nconst turnOutlineProjectionDefinition = {\n\x09key: "turnOutline"\x2C\n\x09stateVersion: 2\x2C\n\x09stateSchema: turnOutlineStateSchema\x2C\n\x09init: () => EMPTY_OUTLINE\x2C\n\x09apply: (state\x2C event) => {\n\x09\x09switch (event.type) {\n\x09\x09\x09case "turn/start": {\n\x09\x09\x09\x09const last = state.turns.at(-1);\n\x09\x09\x09\x09if (last !== void 0 && event.data.turn <= last.turn) return state;\n\x09\x09\x09\x09return {\n\x09\x09\x09\x09\x09turns: [...state.turns\x2C {