script-source,259,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/session/session-format/lib/index.js,import { deepFreeze\x2C snapshotJsonValue } from "@deepseek-ai/dsh-util-values";\n//#region lib/types/error.js\n/** Error raised when a durable Session artifact cannot be restored or migrated losslessly. */\nvar SessionFormatError = class extends Error {\n\x09name = "SessionFormatError";\n};\n/** A readable artifact whose released source policy has no supported migration. */\nvar SessionFormatUnsupportedMigrationError = class extends SessionFormatError {\n\x09name = "SessionFormatUnsupportedMigrationError";\n};\n//#endregion\n//#region lib/types/json.js\n/**\n* Test whether a value is a non-null\x2C non-array object.\n* @param value - candidate value.\n* @returns whether the value is an object record.\n*/\nfunction isSessionFormatJsonObject(value) {\n\x09return typeof value === "object" && value !== null && !Array.isArray(value);\n}\n/**\n* Require a non-negative safe integer without the JSON-unstable negative zero.\n* @param value - candidate count.\n* @param label - diagnostic subject.\n* @returns validated count.\n*/\nfunction sessionFormatCount(value\x2C label) {\n\x09if (!Number.isSafeInteger(value) || value < 0 || Object.is(value\x2C -0)) throw new SessionFormatError(`${label} must be a non-negative safe integer`);\n\x09return value;\n}\n/**\n* Require a safe integer without the JSON-unstable negative zero.\n* @param value - candidate integer.\n* @param label - diagnostic subject.\n* @returns validated integer.\n*/\nfunction sessionFormatSafeInteger(value\x2C label) {\n\x09if (!Number.isSafeInteger(value) || Object.is(value\x2C -0)) throw new SessionFormatError(`${label} must be a safe integer`);\n\x09return value;\n}\n/**\n* Require a non-negative integral format version.\n* @param value - candidate version.\n* @param label - diagnostic subject.\n* @returns validated version.\n*/\nfunction sessionFormatVersion(value\x2C label = "Session format version") {\n\x09return sessionFormatCount(value\x2C label);\n}\n/**\n* Read only the version required for directional dispatch.\n* @param headerValue - untrusted physical header value.\n* @returns validated stored version.\n*/\nfunction inspectSessionFormatVersion(headerValue) {\n\x09if (!isSessionFormatJsonObject(headerValue)) throw new SessionFormatError("Session header must be a JSON object");\n\x09return sessionFormatVersion(headerValue["version"]);\n}\n/**\n* Detach and deeply freeze a caller-supplied lossless JSON value.\n* @param value - borrowed candidate.\n* @param label - diagnostic subject.\n* @returns an immutable detached JSON snapshot.\n*/\nfunction snapshotSessionFormatJson(value\x2C label = "Session value") {\n\x09const snapshot = snapshotJsonValue(value);\n\x09if (snapshot === void 0) throw new SessionFormatError(`${label} is not lossless JSON`);\n\x09return deepFreeze(snapshot);\n}\n/**\n* Snapshot one logical header without inspecting an event body.\n* @param header - borrowed logical header.\n* @param label - diagnostic subject.\n* @returns immutable detached header.\n*/\nfunction snapshotSessionFormatHeader(header\x2C label = "Session header") {\n\x09const snapshot = snapshotSessionFormatJson(header\x2C label);\n\x09if (!isSessionFormatJsonObject(snapshot)) throw new SessionFormatError(`${label} must be a JSON object`);\n\x09inspectSessionFormatVersion(snapshot);\n\x09if (typeof snapshot["id"] !== "string") throw new SessionFormatError(`${label} id must be a string`);\n\x09sessionFormatCount(snapshot["createdAt"]\x2C `${label} createdAt`);\n\x09if (typeof snapshot["isSeeded"] !== "boolean") throw new SessionFormatError(`${label} isSeeded must be a boolean`);\n\x09sessionFormatCount(snapshot["delegationDepth"]\x2C `${label} delegationDepth`);\n\x09return snapshot;\n}\n//#endregion\n//#region lib/types/chain.js\n/**\n* Validate and freeze one adjacent migration declaration.\n* @param migration - named exact adjacent conversion.\n* @returns immutable validated declaration.\n*/\nfunction defineSessionFormatMigration(migration) {\n\x09if (typeof migration.name !== "string" || migration.name.length === 0) throw new SessionFormatError("Session migration name must be a non-empty string");\n\x09const from = sessionFormatVersion(migration.fromVersion\x2C `${migration.name} fromVersion`);\n\x09if (sessionFormatVersion(migration.toVersion\x2C `${migration.name} toVersion`) !== from + 1) throw new SessionFormatError(`${migration.name} must declare adjacent v${from}->v${from + 1}`);\n\x09return Object.freeze({ ...migration });\n}\n/**\n* Compile a unique\x2C complete adjacent migration chain.\n* @param options - current version\x2C adjacent declarations\x2C and current restorer.\n* @returns immutable planner and streaming migration compiler.\n*/\nfunction createSessionFormatChain(options) {\n\x09return new CompiledSessionFormatChain(options);\n}\nvar CompiledSessionFormatChain = class {\n\x09currentVersion;\n\x09migrations;\n\x09restoreCurrentHeader;\n\x09constructor(options) {\n\x09\x09this.currentVersion = sessionFormatVersion(options.currentVersion\x2C "current Session format version");\n\x09\x09this.restoreCurrentHeader = options.restoreCurrentHeader;\n\x09\x09const byFrom = /* @__PURE__ */ new Map();\n\x09\x09const names = /* @__PURE__ */ new Set();\n\x09\x09for (const candidate of options.migrations) {\n\x09\x09\x09const migration = defineSessionFormatMigration(candidate);\n\x09\x09\x09if (byFrom.has(migration.fromVersion)) throw new SessionFormatError(`Session migration v${migration.fromVersion}->v${migration.toVersion} is duplicated`);\n\x09\x09\x09if (names.has(migration.name)) throw new SessionFormatError(`Session migration name ${JSON.stringify(migration.name)} is duplicated`);\n\x09\x09\x09byFrom.set(migration.fromVersion\x2C migration);\n\x09\x09\x09names.add(migration.name);\n\x09\x09}\n\x09\x09const ordered = [];\n\x09\x09for (let version = 0; version < this.currentVersion; version += 1) {\n\x09\x09