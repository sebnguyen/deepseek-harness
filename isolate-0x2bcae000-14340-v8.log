script-source,183,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod/v4/locales/lt.js,import * as util from "../core/util.js";\nconst capitalizeFirstCharacter = (text) => {\n    return text.charAt(0).toUpperCase() + text.slice(1);\n};\nfunction getUnitTypeFromNumber(number) {\n    const abs = Math.abs(number);\n    const last = abs % 10;\n    const last2 = abs % 100;\n    if ((last2 >= 11 && last2 <= 19) || last === 0)\n        return "many";\n    if (last === 1)\n        return "one";\n    return "few";\n}\nconst error = () => {\n    const Sizable = {\n        string: {\n            unit: {\n                one: "simbolis"\x2C\n                few: "simboliai"\x2C\n                many: "simboli\u0173"\x2C\n            }\x2C\n            verb: {\n                smaller: {\n                    inclusive: "turi b\u016bti ne ilgesn\u0117 kaip"\x2C\n                    notInclusive: "turi b\u016bti trumpesn\u0117 kaip"\x2C\n                }\x2C\n                bigger: {\n                    inclusive: "turi b\u016bti ne trumpesn\u0117 kaip"\x2C\n                    notInclusive: "turi b\u016bti ilgesn\u0117 kaip"\x2C\n                }\x2C\n            }\x2C\n        }\x2C\n        file: {\n            unit: {\n                one: "baitas"\x2C\n                few: "baitai"\x2C\n                many: "bait\u0173"\x2C\n            }\x2C\n            verb: {\n                smaller: {\n                    inclusive: "turi b\u016bti ne didesnis kaip"\x2C\n                    notInclusive: "turi b\u016bti ma\u017eesnis kaip"\x2C\n                }\x2C\n                bigger: {\n                    inclusive: "turi b\u016bti ne ma\u017eesnis kaip"\x2C\n                    notInclusive: "turi b\u016bti didesnis kaip"\x2C\n                }\x2C\n            }\x2C\n        }\x2C\n        array: {\n            unit: {\n                one: "element\u0105"\x2C\n                few: "elementus"\x2C\n                many: "element\u0173"\x2C\n            }\x2C\n            verb: {\n                smaller: {\n                    inclusive: "turi tur\u0117ti ne daugiau kaip"\x2C\n                    notInclusive: "turi tur\u0117ti ma\u017eiau kaip"\x2C\n                }\x2C\n                bigger: {\n                    inclusive: "turi tur\u0117ti ne ma\u017eiau kaip"\x2C\n                    notInclusive: "turi tur\u0117ti daugiau kaip"\x2C\n                }\x2C\n            }\x2C\n        }\x2C\n        set: {\n            unit: {\n                one: "element\u0105"\x2C\n                few: "elementus"\x2C\n                many: "element\u0173"\x2C\n            }\x2C\n            verb: {\n                smaller: {\n                    inclusive: "turi tur\u0117ti ne daugiau kaip"\x2C\n                    notInclusive: "turi tur\u0117ti ma\u017eiau kaip"\x2C\n                }\x2C\n                bigger: {\n                    inclusive: "turi tur\u0117ti ne ma\u017eiau kaip"\x2C\n                    notInclusive: "turi tur\u0117ti daugiau kaip"\x2C\n                }\x2C\n            }\x2C\n        }\x2C\n    };\n    function getSizing(origin\x2C unitType\x2C inclusive\x2C targetShouldBe) {\n        const result = Sizable[origin] ?? null;\n        if (result === null)\n            return result;\n        return {\n            unit: result.unit[unitType]\x2C\n            verb: result.verb[targetShouldBe][inclusive ? "inclusive" : "notInclusive"]\x2C\n        };\n    }\n    const FormatDictionary = {\n        regex: "\u012fvestis"\x2C\n        email: "el. pa\u0161to adresas"\x2C\n        url: "URL"\x2C\n        emoji: "jaustukas"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "ISO data ir laikas"\x2C\n        date: "ISO data"\x2C\n        time: "ISO laikas"\x2C\n        duration: "ISO trukm\u0117"\x2C\n        ipv4: "IPv4 adresas"\x2C\n        ipv6: "IPv6 adresas"\x2C\n        cidrv4: "IPv4 tinklo prefiksas (CIDR)"\x2C\n        cidrv6: "IPv6 tinklo prefiksas (CIDR)"\x2C\n        base64: "base64 u\u017ekoduota eilut\u0117"\x2C\n        base64url: "base64url u\u017ekoduota eilut\u0117"\x2C\n        json_string: "JSON eilut\u0117"\x2C\n        e164: "E.164 numeris"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "\u012fvestis"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "skai\u010dius"\x2C\n        bigint: "sveikasis skai\u010dius"\x2C\n        string: "eilut\u0117"\x2C\n        boolean: "login\u0117 reik\u0161m\u0117"\x2C\n        undefined: "neapibr\u0117\u017eta reik\u0161m\u0117"\x2C\n        function: "funkcija"\x2C\n        symbol: "simbolis"\x2C\n        array: "masyvas"\x2C\n        object: "objektas"\x2C\n        null: "nulin\u0117 reik\u0161m\u0117"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Gautas tipas ${received}\x2C o tik\u0117tasi - instanceof ${issue.expected}`;\n                }\n                return `Gautas tipas ${received}\x2C o tik\u0117tasi - ${expected}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Privalo b\u016bti ${util.stringifyPrimitive(issue.values[0])}`;\n                return `Privalo b\u016bti vienas i\u0161 ${util.joinValues(issue.values\x2C "|")} pasirinkim\u0173`;\n            case "too_big": {\n                const origin = TypeDictionary[issue.origin] ?? issue.origin;\n                const sizing = getSizing(issue.origin\x2C getUnitTypeFromNumber(Number(issue.maximum))\x2C issue.inclusive ?? false\x2C "smaller");\n                if (sizing?.verb)\n                    return `${capitalizeFirstCharacter(origin ?? issue.origin ?? "reik\u0161m\u0117")} ${sizing.verb} ${issue.maximum.toString()} ${sizing.unit ?? "element\u0173"}`;\n                const adj = issue.inclusive ? "ne didesnis kaip" : "ma\u017eesnis kaip";\n                return `${capitalizeFirstCharacter(origin ?? issue.origin ?? "reik\u0161m\u0117")} turi b\u016bti ${adj} ${issue.maximum.toString()} ${sizing?.unit}`;\n            }\n            case "too_small": {\n                const origin = TypeDictionary[issue.origin] ?? issue.origin;\n                const sizing = getSizing(issue.origin\x2C getUnitTypeFromNumber(Number(issue.minimum))\x2C issue.inclusive ?? false\x2C "bigger");\n                if (sizing?.verb)\n                    return `${capitalizeFirstCharacter(origin ?? issue.origin ?? "reik\u0161m\u0117")} ${sizing.verb} ${issue.minimum.toString()} ${sizing.unit ?? "element\u0173"}`;\n                const adj = issue.inclusive ? "ne ma\u017eesnis kaip" : "didesnis kaip";\n                return `${capitalizeFirstCharacter(origin ?? issue.origin ?? "reik\u0161m\u0117")} turi b\u016bti ${adj} ${issue.minimum.toString()} ${sizing?.unit}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with") {\n                    return `Eilut\u0117 privalo prasid\u0117ti "${_issue.prefix}"`;\n                }\n                if (_issue.format === "ends_with")\n                    return `Eilut\u0117 privalo pasibaigti "${_issue.suffix}"`;\n                if (_issue.format === "includes")\n                    return `Eilut\u0117 privalo \u012ftraukti "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `Eilut\u0117 privalo atitikti ${_issue.pattern}`;\n                return `Neteisingas ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `Skai\u010dius privalo b\u016bti ${issue.divisor} kartotinis.`;\n            case "unrecognized_keys":\n                return `Neatpa\u017eint${issue.keys.length > 1 ? "i" : "as"} rakt${issue.keys.length > 1 ? "ai" : "as"}: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return "Rastas klaidingas raktas";\n            case "invalid_union":\n                return "Klaidinga \u012fvestis";\n            case "invalid_element": {\n                const origin = TypeDictionary[issue.origin] ?? issue.origin;\n                return `${capitalizeFirstCharacter(origin ?? issue.origin ?? "reik\u0161m\u0117")} turi klaiding\u0105 \u012fvest\u012f`;\n            }\n            default:\n                return "Klaidinga \u012fvestis";\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
