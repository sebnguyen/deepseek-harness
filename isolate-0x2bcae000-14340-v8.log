script-source,229,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/typert/protocol/lib/index.js,import { Service } from "@deepseek-ai/cordis";\n//#region lib/types/remote-error.js\n/** The one Remote failure class shared by owners\x2C the Gateway\x2C and consumers. */\n/**\n* One Remote call failure: a real Error carrying its stable code and typed\n* details. Owners throw it at the failure point; the Host Gateway encodes it\n* onto the wire unchanged; the Client face rebuilds an instance for the\n* `RemoteResult` error branch\x2C so `throw result.error` keeps throw semantics.\n* Discrimination is always by `code`\x2C never by instanceof.\n*/\nvar RemoteError = class extends Error {\n\x09code;\n\x09details;\n\x09/** Structural marker: cross-realm/bundle identification never uses instanceof. */\n\x09isDSHRemoteError = true;\n\x09/**\n\x09* @param code - stable failure code declared in {@link RemoteErrorDetailsMap}.\n\x09* @param message - human diagnostic carried across the wire.\n\x09* @param details - structured payload typed by the code.\n\x09* @param options - standard Error options (`cause` survives in-process only).\n\x09*/\n\x09constructor(code\x2C message\x2C details\x2C options) {\n\x09\x09super(message\x2C options);\n\x09\x09this.code = code;\n\x09\x09this.details = details;\n\x09\x09this.name = "RemoteError";\n\x09}\n};\n/**\n* Structurally identify a RemoteError thrown across module or realm copies of\n* this class. Mechanism-internal: the Gateway and test assertions use it;\n* business code receives typed failures and never needs it.\n* @param value - a caught value.\n* @returns the failure when the marker matches\x2C otherwise undefined.\n*/\nfunction remoteErrorOf(value) {\n\x09if (typeof value === "object" && value !== null && value.isDSHRemoteError === true && typeof value.code === "string") return value;\n}\n//#endregion\n//#region lib/types/index.js\n/**\n* Remote decorators and explicit Gateway bindings backed by versioned\n* descriptors carried on decorated class prototypes. Strict reflection\n* remains a Typert compiler responsibility.\n* @module @deepseek-ai/dsh-typert-protocol\n*/\nconst TYPERT_REMOTE_SEGMENT_PATTERN = /^[A-Za-z0-9_$.-]+$/;\n/**\n* Test one generated Remote name against the Connection endpoint grammar.\n* @param value - namespace\x2C method\x2C lookup\x2C or Context segment.\n* @returns whether the value can cross the shared RPC carrier unchanged.\n*/\nfunction isTypertRemoteSegment(value) {\n\x09return value !== "." && value !== ".." && TYPERT_REMOTE_SEGMENT_PATTERN.test(value);\n}\nconst REMOTE_METHOD_DESCRIPTOR = "@deepseek-ai/dsh-typert-protocol/remote-methods";\n/**\n* Bind one visible Service field to a Cordis key and Remote namespace.\n* @param service - owning Service instance\x2C normally `this`.\n* @param serviceKey - exact Cordis service key.\n* @param options - optional distinct wire namespace.\n* @returns a frozen\x2C inspectable binding with no compiler-injected metadata.\n*/\nfunction bindTypertRemote(service\x2C serviceKey\x2C options = {}) {\n\x09validateName("service key"\x2C serviceKey);\n\x09const namespace = options.namespace ?? serviceKey;\n\x09validateName("namespace"\x2C namespace);\n\x09return Object.freeze({\n\x09\x09service\x2C\n\x09\x09serviceKey\x2C\n\x09\x09namespace\n\x09});\n}\n/** Cordis Service base that exposes its registered name through Typert Gateway. */\nvar TypertRemoteService = class extends Service {\n\x09/** Visible binding consumed by the Gateway's source-mode discovery. */\n\x09typertRemote;\n\x09/**\n\x09* Register the Service and bind the same key to Typert Gateway.\n\x09* @param ctx - owning Cordis Context.\n\x09* @param serviceKey - exact Cordis service key and default wire namespace.\n\x09* @param options - optional distinct wire namespace.\n\x09*/\n\x09constructor(ctx\x2C serviceKey\x2C options = {}) {\n\x09\x09super(ctx\x2C serviceKey);\n\x09\x09this.typertRemote = bindTypertRemote(this\x2C this.name\x2C options);\n\x09}\n};\nfunction Remote(methodExportOrOptions\x2C context) {\n\x09if (typeof methodExportOrOptions === "string") {\n\x09\x09validateName("Remote export name"\x2C methodExportOrOptions);\n\x09\x09return remoteDecorator({ kind: "direct" }\x2C void 0\x2C methodExportOrOptions);\n\x09}\n\x09if (typeof methodExportOrOptions === "object") {\n\x09\x09if (remoteOptionMode(methodExportOrOptions) !== "stream" || Reflect.ownKeys(methodExportOrOptions).length !== 1) throw new TypeError("typert-protocol: Remote options must contain exactly mode: \\"stream\\"");\n\x09\x09return remoteDecorator({ kind: "direct" }\x2C "stream");\n\x09}\n\x09if (context === void 0) throw new TypeError("typert-protocol: Remote decorator context is missing");\n\x09addMarkerInitializer(context\x2C { kind: "direct" });\n}\nfunction remoteOptionMode(options) {\n\x09return Reflect.get(options\x2C "mode");\n}\nfunction remoteDecorator(invocation\x2C mode\x2C exportName) {\n\x09return function(_method\x2C context) {\n\x09\x09addMarkerInitializer(context\x2C invocation\x2C mode\x2C exportName);\n\x09};\n}\n/**\n* Create a decorator for a method resolved from one Remote Scope.\n* @param key - scope key declared through the Context map.\n* @param exportName - optional Remote export name; defaults to the method name.\n* @returns a standard method decorator that records a versioned prototype descriptor.\n*/\nfunction RemoteScope(key\x2C exportName) {\n\x09validateName("Scope key"\x2C key);\n\x09if (exportName !== void 0) validateName("Remote export name"\x2C exportName);\n\x09return remoteDecorator({\n\x09\x09kind: "context"\x2C\n\x09\x09context: key\n\x09}\x2C void 0\x2C exportName);\n}\n/**\n* Read Remote markers attached to a live Service's class prototype.\n* The returned snapshot cannot mutate the stored descriptor.\n* @param service - live Service instance.\n* @returns markers in class declaration order.\n*/\nfunction remoteMethods(service) {\n\x09const prototype = Object.getPrototypeOf(service);\n\x09if (prototype === null) return [];\n\x09return (readRemoteMethodDescriptor(prototype)?.methods ?? []).map((marker) => ({ ...marker }));\n}\nfunction readRemoteMethodDescriptor(prototype) {\n\x09const property = Object.getOwnPropertyDescriptor(prototype\x2C REMOTE_METHOD_DESCRIPTOR);\n\x09if (property === void 0) return void 0;\n\x09const descriptor = property.value;\n\x09if (descriptor === null || typeof descriptor !== "object") throw new TypeError("typert-protocol: Remote method descriptor must be an object");\n\x09const version = Reflect.get(descriptor\x2C "version");\n\x09if (version !== 1) throw new TypeError(`typert-protocol: unsupported Remote method descriptor version ${String(version)}`);\n\x09const methods = Reflect.get(descriptor\x2C "methods");\n\x09if (!Array.isArray(methods)) throw new TypeError("typert-protocol: Remote method descriptor methods must be an array");\n\x09return descriptor;\n}\nfunction addMarkerInitializer(context\x2C invocation\x2C mode\x2C exportName) {\n\x09if (context.private || context.static || typeof context.name !== "string") throw new TypeError("typert-protocol: Remote decorators require a public instance method with a string name");\n\x09const method = context.name;\n\x09context.addInitializer(function() {\n\x09\x09const prototype = Object.getPrototypeOf(this);\n\x09\x09if (prototype === null) throw new TypeError(`typert-protocol: cannot mark Remote method "${method}" on an object without a prototype`);\n\x09\x09mark(prototype\x2C method\x2C invocation\x2C mode\x2C exportName);\n\x09});\n}\nfunction mark(prototype\x2C method\x2C invocation\x2C mode\x2C exportName) {\n\x09const descriptor = readRemoteMethodDescriptor(prototype);\n\x09const marker = Object.freeze({\n\x09\x09method\x2C\n\x09\x09...exportName === void 0 || exportName === method ? {} : { exportName }\x2C\n\x09\x09...mode === void 0 ? {} : { mode }\x2C\n\x09\x09invocation: Object.freeze(invocation)\n\x09});\n\x09const current = descriptor?.methods.find((candidate) => candidate.method === method);\n\x09if (current !== void 0) {\n\x09\x09if (current.exportName === marker.exportName && current.mode === marker.mode && sameInvocation(current.invocation\x2C invocation)) return;\n\x09\x09throw new Error(`typert-protocol: Remote method "${method}" has conflicting invocation markers`);\n\x09}\n\x09Object.defineProperty(prototype\x2C REMOTE_METHOD_DESCRIPTOR\x2C {\n\x09\x09configurable: true\x2C\n\x09\x09value: Object.freeze({\n\x09\x09\x09version: 1\x2C\n\x09\x09\x09methods: Object.freeze([...descriptor?.methods ?? []\x2C marker])\n\x09\x09})\n\x09});\n}\nfunction sameInvocation(left\x2C right) {\n\x09if (left.kind === "direct") return right.kind === "direct";\n\x09if (right.kind === "direct") return false;\n\x09return left.context === right.context;\n}\nfunction validateName(subject\x2C value) {\n\x09if (!isTypertRemoteSegment(value)) throw new TypeError(`typert-protocol: ${subject} must contain only RPC endpoint segment characters`);\n}\n//#endregion\nexport { Remote\x2C RemoteError\x2C RemoteScope\x2C TypertRemoteService\x2C bindTypertRemote\x2C isTypertRemoteSegment\x2C remoteErrorOf\x2C remoteMethods };\n
