script-source,203,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod/v4/locales/vi.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "k\xfd t\u1ef1"\x2C verb: "c\xf3" }\x2C\n        file: { unit: "byte"\x2C verb: "c\xf3" }\x2C\n        array: { unit: "ph\u1ea7n t\u1eed"\x2C verb: "c\xf3" }\x2C\n        set: { unit: "ph\u1ea7n t\u1eed"\x2C verb: "c\xf3" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "\u0111\u1ea7u v\xe0o"\x2C\n        email: "\u0111\u1ecba ch\u1ec9 email"\x2C\n        url: "URL"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "ng\xe0y gi\u1edd ISO"\x2C\n        date: "ng\xe0y ISO"\x2C\n        time: "gi\u1edd ISO"\x2C\n        duration: "kho\u1ea3ng th\u1eddi gian ISO"\x2C\n        ipv4: "\u0111\u1ecba ch\u1ec9 IPv4"\x2C\n        ipv6: "\u0111\u1ecba ch\u1ec9 IPv6"\x2C\n        cidrv4: "d\u1ea3i IPv4"\x2C\n        cidrv6: "d\u1ea3i IPv6"\x2C\n        base64: "chu\u1ed7i m\xe3 h\xf3a base64"\x2C\n        base64url: "chu\u1ed7i m\xe3 h\xf3a base64url"\x2C\n        json_string: "chu\u1ed7i JSON"\x2C\n        e164: "s\u1ed1 E.164"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "\u0111\u1ea7u v\xe0o"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "s\u1ed1"\x2C\n        array: "m\u1ea3ng"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `\u0110\u1ea7u v\xe0o kh\xf4ng h\u1ee3p l\u1ec7: mong \u0111\u1ee3i instanceof ${issue.expected}\x2C nh\u1eadn \u0111\u01b0\u1ee3c ${received}`;\n                }\n                return `\u0110\u1ea7u v\xe0o kh\xf4ng h\u1ee3p l\u1ec7: mong \u0111\u1ee3i ${expected}\x2C nh\u1eadn \u0111\u01b0\u1ee3c ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `\u0110\u1ea7u v\xe0o kh\xf4ng h\u1ee3p l\u1ec7: mong \u0111\u1ee3i ${util.stringifyPrimitive(issue.values[0])}`;\n                return `T\xf9y ch\u1ecdn kh\xf4ng h\u1ee3p l\u1ec7: mong \u0111\u1ee3i m\u1ed9t trong c\xe1c gi\xe1 tr\u1ecb ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `Qu\xe1 l\u1edbn: mong \u0111\u1ee3i ${issue.origin ?? "gi\xe1 tr\u1ecb"} ${sizing.verb} ${adj}${issue.maximum.toString()} ${sizing.unit ?? "ph\u1ea7n t\u1eed"}`;\n                return `Qu\xe1 l\u1edbn: mong \u0111\u1ee3i ${issue.origin ?? "gi\xe1 tr\u1ecb"} ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `Qu\xe1 nh\u1ecf: mong \u0111\u1ee3i ${issue.origin} ${sizing.verb} ${adj}${issue.minimum.toString()} ${sizing.unit}`;\n                }\n                return `Qu\xe1 nh\u1ecf: mong \u0111\u1ee3i ${issue.origin} ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `Chu\u1ed7i kh\xf4ng h\u1ee3p l\u1ec7: ph\u1ea3i b\u1eaft \u0111\u1ea7u b\u1eb1ng "${_issue.prefix}"`;\n                if (_issue.format === "ends_with")\n                    return `Chu\u1ed7i kh\xf4ng h\u1ee3p l\u1ec7: ph\u1ea3i k\u1ebft th\xfac b\u1eb1ng "${_issue.suffix}"`;\n                if (_issue.format === "includes")\n                    return `Chu\u1ed7i kh\xf4ng h\u1ee3p l\u1ec7: ph\u1ea3i bao g\u1ed3m "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `Chu\u1ed7i kh\xf4ng h\u1ee3p l\u1ec7: ph\u1ea3i kh\u1edbp v\u1edbi m\u1eabu ${_issue.pattern}`;\n                return `${FormatDictionary[_issue.format] ?? issue.format} kh\xf4ng h\u1ee3p l\u1ec7`;\n            }\n            case "not_multiple_of":\n                return `S\u1ed1 kh\xf4ng h\u1ee3p l\u1ec7: ph\u1ea3i l\xe0 b\u1ed9i s\u1ed1 c\u1ee7a ${issue.divisor}`;\n            case "unrecognized_keys":\n                return `Kh\xf3a kh\xf4ng \u0111\u01b0\u1ee3c nh\u1eadn d\u1ea1ng: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `Kh\xf3a kh\xf4ng h\u1ee3p l\u1ec7 trong ${issue.origin}`;\n            case "invalid_union":\n                return "\u0110\u1ea7u v\xe0o kh\xf4ng h\u1ee3p l\u1ec7";\n            case "invalid_element":\n                return `Gi\xe1 tr\u1ecb kh\xf4ng h\u1ee3p l\u1ec7 trong ${issue.origin}`;\n            default:\n                return `\u0110\u1ea7u v\xe0o kh\xf4ng h\u1ee3p l\u1ec7`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
