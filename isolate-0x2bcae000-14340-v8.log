nt must rewrite exactly one current node');\n    }\n    for (const originalSeq of shadowedSeqs) {\n        const original = events[originalSeq - baseSeq];\n        if (original?.type !== 'tool/result') {\n            throw new Error('tool/result surface replacement must target a current tool/result');\n        }\n        const originalRest = { ...original.data };\n        const replacementRest = { ...event.data };\n        const originalResult = original.data.message.content[0];\n        const replacementResult = event.data.message.content[0];\n        originalRest['message'] = {\n            ...original.data.message\x2C\n            content: [{ ...originalResult\x2C content: null }]\x2C\n        };\n        replacementRest['message'] = {\n            ...event.data.message\x2C\n            content: [{ ...replacementResult\x2C content: null }]\x2C\n        };\n        if (!isDeepEqualJson(originalRest\x2C replacementRest)) {\n            throw new Error('tool/result surface replacement may change only content');\n        }\n    }\n}\n/**\n * Protect the system prompt at surface node 0. A replacement covering node 0\n * while that node is a `system/message` must itself be a `system/message` over\n * exactly that node; later system nodes carry no protection and a compaction\n * range may shadow them.\n */\nfunction assertSystemHeadRewrite(event\x2C state\x2C startIdx\x2C shadowedSeqs\x2C events\x2C baseSeq) {\n    if (startIdx !== 0)\n        return;\n    const head = events[state.nodes[0] - baseSeq];\n    if (head?.type !== 'system/message')\n        return;\n    if (event.type !== 'system/message' || shadowedSeqs.length !== 1) {\n        throw new Error('surface replace: node 0 holds the system prompt and may be rewritten only by a system/message over exactly that node');\n    }\n}\n/** Validate one event at its replay boundary and prepare its atomic fold transition. */\nfunction planSurfaceEvent(state\x2C event\x2C expectedSeq\x2C events\x2C baseSeq) {\n    if (event.seq !== expectedSeq) {\n        throw new Error(`session event seq ${event.seq} is not contiguous; expected ${expectedSeq}`);\n    }\n    const surfaceOp = validateSurfaceMetadata(event);\n    if (surfaceOp === undefined)\n        return;\n    if (surfaceOp === 'append') {\n        return { kind: 'append'\x2C seq: event.seq };\n    }\n    const range = replacementRange(state\x2C surfaceOp);\n    assertProvenance(event\x2C range.shadowedSeqs);\n    assertToolResultRewrite(event\x2C range.shadowedSeqs\x2C events\x2C baseSeq);\n    assertSystemHeadRewrite(event\x2C state\x2C range.startIdx\x2C range.shadowedSeqs\x2C events\x2C baseSeq);\n    return {\n        kind: 'replace'\x2C\n        seq: event.seq\x2C\n        start: surfaceOp.startSeq\x2C\n        end: surfaceOp.endSeq\x2C\n        ...range\x2C\n    };\n}\n/** Apply one event and return replacement metadata only when one occurred. */\nfunction applySurfaceEvent(state\x2C event\x2C expectedSeq\x2C events\x2C baseSeq) {\n    const plan = planSurfaceEvent(state\x2C event\x2C expectedSeq\x2C events\x2C baseSeq);\n    return applySurfacePlan(state\x2C plan);\n}\n/** Commit one previously validated surface transition. */\nfunction applySurfacePlan(state\x2C plan) {\n    if (plan?.kind === 'append') {\n        state.nodes.push(plan.seq);\n    }\n    else if (plan?.kind === 'replace') {\n        state.nodes.splice(plan.startIdx\x2C plan.endIdx - plan.startIdx + 1\x2C plan.seq);\n        state.replaceGeneration += 1;\n    }\n    if (plan?.kind !== 'replace')\n        return;\n    return {\n        seq: plan.seq\x2C\n        start: plan.start\x2C\n        end: plan.end\x2C\n        shadowedSeqs: plan.shadowedSeqs\x2C\n    };\n}\n/**\n * Replay a complete session log through the canonical surface fold.\n * @param events - session events in contiguous seq order.\n * @returns detached current sequences and replacement history.\n * @throws when an event violates surface metadata\x2C source-event references\x2C range\x2C or t