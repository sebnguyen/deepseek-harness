t received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `F\xe2sit giren: umulan instanceof ${issue.expected}\x2C al\u0131nan ${received}`;\n                }\n                return `F\xe2sit giren: umulan ${expected}\x2C al\u0131nan ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `F\xe2sit giren: umulan ${util.stringifyPrimitive(issue.values[0])}`;\n                return `F\xe2sit tercih: m\xfbteberler ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `Fazla b\xfcy\xfck: ${issue.origin ?? "value"}\x2C ${adj}${issue.maximum.toString()} ${sizing.unit ?? "elements"} sahip olmal\u0131yd\u0131.`;\n                return `Fazla b\xfcy\xfck: ${issue.origin ?? "value"}\x2C ${adj}${issue.maximum.toString()} olmal\u0131yd\u0131.`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `Fazla k\xfc\xe7\xfck: ${issue.origin}\x2C ${adj}${issue.minimum.toString()} ${sizing.unit} sahip olmal\u0131yd\u0131.`;\n                }\n                return `Fazla k\xfc\xe7\xfck: ${issue.origin}\x2C ${adj}${issue.minimum.toString()} olmal\u0131yd\u0131.`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `F\xe2sit metin: "${_issue.prefix}" ile ba\u015flamal\u0131.`;\n                if (_issue.format === "ends_with")\n                    return `F\xe2sit metin: "${_issue.suffix}" ile bitmeli.`;\n                if (_issue.format === "includes")\n                    return `F\xe2sit metin: "${_issue.includes}" ihtiv\xe2 etmeli.`;\n                if (_issue.format === "regex")\n                    return `F\xe2sit metin: ${_issue.pattern} nak\u015f\u0131na uymal\u0131.`;\n                return `F\xe2sit ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `F\xe2sit say\u0131: ${issue.divisor} kat\u0131 olmal\u0131yd\u0131.`;\n            case "unrecognized_keys":\n                return `Tan\u0131nmayan anahtar ${issue.keys.length > 1 ? "s" : ""}: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `${issue.origin} i\xe7in tan\u0131nmayan anahtar var.`;\n            case "invalid_union":\n                return "Giren tan\u0131namad\u0131.";\n            case "invalid_element":\n                return `${issue.origin} i\xe7in tan\u0131nmayan k\u0131ymet var.`;\n            default:\n                return `K\u0131ymet tan\u0131namad\u0131.`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
