script-source,255,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/vendor/include/lib/index.js,import { EntryGroup\x2C EntryTree\x2C isJsExpr } from "@deepseek-ai/cordis-plugin-loader";\nimport { Service } from "@deepseek-ai/cordis";\nimport { extname } from "node:path";\nimport { access\x2C constants\x2C readFile\x2C rename\x2C writeFile } from "node:fs/promises";\nimport { setTimeout as setTimeout$1 } from "node:timers/promises";\nimport { fileURLToPath\x2C pathToFileURL } from "node:url";\nimport * as yaml from "js-yaml";\n//#region lib/types/index.js\nvar __rewriteRelativeImportExtension = function(path\x2C preserveJsx) {\n\x09if (typeof path === "string" && /^\\.\\.?\\//.test(path)) return path.replace(/\\.(tsx)$|((?:\\.d)?)((?:\\.[^./]+?)?)\\.([cm]?)ts$/i\x2C function(m\x2C tsx\x2C d\x2C ext\x2C cm) {\n\x09\x09return tsx ? preserveJsx ? ".jsx" : ".js" : d && (!ext || !cm) ? m : d + ext + "." + cm.toLowerCase() + "js";\n\x09});\n\x09return path;\n};\nconst JsExpr = new yaml.Type("tag:yaml.org\x2C2002:js"\x2C {\n\x09kind: "scalar"\x2C\n\x09resolve: (data) => typeof data === "string"\x2C\n\x09construct: (data) => ({ __jsExpr: data })\x2C\n\x09predicate: isJsExpr\x2C\n\x09represent: (data) => data["__jsExpr"]\n});\n/**\n* The entry-list YAML dialect: `!!js` scalars round-trip as expression nodes\n* the Loader evaluates at entry activation. Exported so config tooling\n* (`dsh --dump-config`) parses and prints exactly the dialect this include\n* mounts.\n*/\nconst entryListSchema = yaml.JSON_SCHEMA.extend(JsExpr);\nconst schema = entryListSchema;\nconst writable = {\n\x09".json": "application/json"\x2C\n\x09".yaml": "application/yaml"\x2C\n\x09".yml": "application/yaml"\n};\nconst supported = new Set(Object.keys(writable));\nconst WRITE_RETRY_LIMIT = 10;\nconst WRITE_RETRY_DELAY_MS = 50;\nfunction retryableWriteError(error) {\n\x09const code = error?.code;\n\x09return code === "EACCES" || code === "EBUSY" || code === "EPERM";\n}\n/**\n* Apply patch lists to an entry list \u2014 THE patch semantics of this include\x2C\n* shared by mounting (`applyPatches`) and offline config tooling\n* (`dsh --dump-config`) so a dump can never drift from what boots. The input\n* is never mutated and the result is always detached from it (even with no\n* patches): patching or mounting shared entry objects would bake earlier\n* values into the cached parse\x2C so repeated application (config hot-reloads)\n* could never revert a removed or changed patch. Inserted entries are indexed\n* as they are added\x2C so a later patch in the same list can target a row an\n* earlier patch inserted. A patch that matches nothing warns and is skipped.\n* @param data - the parsed entry list (JSON-safe plain data).\n* @param patches - the patch list to apply\x2C in order.\n* @param warn - sink for skipped-patch diagnostics (printf-style\x2C `%C` = code).\n* @returns a detached entry list with every applicable patch applied.\n*/\nfunction applyEntryPatches(data\x2C patches\x2C warn) {\n\x09data = structuredClone(data);\n\x09if (!patches?.length) return data;\n\x09const entryMap = /* @__PURE__ */ new Map();\n\x09const buildMap = (entries) => {\n\x09\x09for (const entry of entries) {\n\x09\x09\x09if (entry.id) entryMap.set(entry.id\x2C entry);\n\x09\x09\x09if (entry.group && Array.isArray(entry.config)) buildMap(entry.config);\n\x09\x09}\n\x09};\n\x09buildMap(data);\n\x09for (const patch of patches) {\n\x09\x09const { id\x2C insert\x2C name\x2C ...overrides } = patch;\n\x09\x09if (insert) {\n\x09\x09\x09if (id) {\n\x09\x09\x09\x09const target = entryMap.get(id);\n\x09\x09\x09\x09if (!target) {\n\x09\x09\x09\x09\x09warn("patch insert: entry %C not found"\x2C id);\n\x09\x09\x09\x09\x09continue;\n\x09\x09\x09\x09}\n\x09\x09\x09\x09if (!target.group) {\n\x09\x09\x09\x09\x09warn("patch insert: entry %C is not a group"\x2C id);\n\x09\x09\x09\x09\x09continue;\n\x09\x09\x09\x09}\n\x09\x09\x09\x09if (!Array.isArray(target.config)) target.config = [];\n\x09\x09\x09\x09target.config.push(...insert);\n\x09\x09\x09} else data.push(...insert);\n\x09\x09\x09buildMap(insert);\n\x09\x09\x09continue;\n\x09\x09}\n\x09\x09if (!id) {\n\x09\x09\x09warn("patch: id is required for non-insert patches");\n\x09\x09\x09continue;\n\x09\x09}\n\x09\x09const target = entryMap.get(id);\n\x09\x09if (!target) {\n\x09\x09\x09warn("patch: entry %C not found"\x2C id);\n\x09\x09\x09continue;\n\x09\x09}\n\x09\x09if (name && name !== target.name) {\n\x09\x09\x09warn("patch: name mismatch for %C (expected %C\x2C got %C)\x2C skipping"\x2C id\x2C target.name\x2C name);\n\x09\x09\x09continue;\n\x09\x09}\n\x09\x09for (const [key\x2C value] of Object.entries(overrides)) {\n\x09\x09\x09if (key === "id") continue;\n\x09\x09\x09target[key] = value;\n\x09\x09}\n\x09}\n\x09return data;\n}\nvar ConfigFileError = class extends Error {\n\x09stage;\n\x09constructor(stage\x2C path\x2C cause) {\n\x09\x09super(`failed to ${stage} config file ${path}`\x2C { cause });\n\x09\x09this.stage = stage;\n\x09\x09this.name = "ConfigFileError";\n\x09}\n};\n/** Loader entry tree backed by a YAML or JSON file. */\nvar Include = class extends EntryTree {\n\x09config;\n\x09static inject = ["loader"];\n\x09static [EntryGroup.key] = true;\n\x09filename;\n\x09type;\n\x09readonly;\n\x09content;\n\x09data;\n\x09writeTask;\n\x09pendingWrite;\n\x09writeQueue = Promise.resolve();\n\x09applyQueue = Promise.resolve();\n\x09constructor(ctx\x2C config) {\n\x09\x09super(ctx);\n\x09\x09this.config = config;\n\x09\x09this.enableLogs = config.enableLogs ?? ctx.fiber.entry?.parent.tree.enableLogs ?? false;\n\x09\x09this.filename = fileURLToPath(new URL(this.config.path\x2C this.ctx.baseUrl));\n\x09\x09const ext = extname(this.filename);\n\x09\x09if (!supported.has(ext)) throw new Error(`extension "${ext}" not supported`);\n\x09\x09this.type = writable[ext];\n\x09\x09this.readonly = !this.type;\n\x09\x09this.ctx.baseUrl = new URL("."\x2C pathToFileURL(this.filename)).href;\n\x09\x09ctx.on("internal/update"\x2C async (config\x2C _\x2C next) => {\n\x09\x09\x09if (config.path !== this.config.path) return next();\n\x09\x09\x09await this.enqueue(async () => {\n\x09\x09\x09\x09const data = this.applyPatches(this.data\x2C config.patches);\n\x09\x09\x09\x09await this.root.update(data);\n\x09\x09\x09\x09this.config = config;\n\x09\x09\x09});\n\x09\x09});\n\x09}\n\x09/**\n\x09* Serialize one child-tree mutation behind every earlier one. The group's\n\x09* transactional `update` is not reentrant: two concurrent applies (the init\n\x09* apply racing an HMR-triggered refresh from the watcher's initial scan)\n\x09* interleave create and rollback on the same entries and strand the include\n\x09* fiber without settling\x2C so every apply path funnels through this queue.\n\x09* A predecessor's failure is its own caller's outcome and never gates the\n\x09* next task.\n\x09*/\n\x09enqueue(task) {\n\x09\x09const run = this.applyQueue.then(task\x2C task);\n\x09\x09this.applyQueue = run.then(() => {}\x2C () => {});\n\x09\x09return run;\n\x09}\n\x09async checkAccess() {\n\x09\x09if (!this.type) return;\n\x09\x09try {\n\x09\x09\x09await access(this.filename\x2C constants.W_OK);\n\x09\x09} catch {\n\x09\x09\x09this.readonly = true;\n\x09\x09}\n\x09}\n\x09async read(forced = false) {\n\x09\x09let content;\n\x09\x09try {\n\x09\x09\x09content = await readFile(this.filename\x2C "utf8");\n\x09\x09} catch (error) {\n\x09\x09\x09throw new ConfigFileError("read"\x2C this.filename\x2C error);\n\x09\x09}\n\x09\x09if (!forced && this.content === content) return;\n\x09\x09let data;\n\x09\x09try {\n\x09\x09\x09if (this.type === "application/yaml") data = yaml.load(content\x2C { schema });\n\x09\x09\x09else if (this.type === "application/json") data = JSON.parse(content);\n\x09\x09\x09else {\n\x09\x09\x09\x09const module = await import(__rewriteRelativeImportExtension(\n\x09\x09\x09\x09\x09/* @vite-ignore */\n\x09\x09\x09\x09\x09this.filename\n\x09\x09\x09\x09));\n\x09\x09\x09\x09data = module.default || mo