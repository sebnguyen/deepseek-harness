script-source,189,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod/v4/locales/ps.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "\u062a\u0648\u06a9\u064a"\x2C verb: "\u0648\u0644\u0631\u064a" }\x2C\n        file: { unit: "\u0628\u0627\u06cc\u067c\u0633"\x2C verb: "\u0648\u0644\u0631\u064a" }\x2C\n        array: { unit: "\u062a\u0648\u06a9\u064a"\x2C verb: "\u0648\u0644\u0631\u064a" }\x2C\n        set: { unit: "\u062a\u0648\u06a9\u064a"\x2C verb: "\u0648\u0644\u0631\u064a" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "\u0648\u0631\u0648\u062f\u064a"\x2C\n        email: "\u0628\u0631\u06cc\u069a\u0646\u0627\u0644\u06cc\u06a9"\x2C\n        url: "\u06cc\u0648 \u0622\u0631 \u0627\u0644"\x2C\n        emoji: "\u0627\u06cc\u0645\u0648\u062c\u064a"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "\u0646\u06cc\u067c\u0647 \u0627\u0648 \u0648\u062e\u062a"\x2C\n        date: "\u0646\u06d0\u067c\u0647"\x2C\n        time: "\u0648\u062e\u062a"\x2C\n        duration: "\u0645\u0648\u062f\u0647"\x2C\n        ipv4: "\u062f IPv4 \u067e\u062a\u0647"\x2C\n        ipv6: "\u062f IPv6 \u067e\u062a\u0647"\x2C\n        cidrv4: "\u062f IPv4 \u0633\u0627\u062d\u0647"\x2C\n        cidrv6: "\u062f IPv6 \u0633\u0627\u062d\u0647"\x2C\n        base64: "base64-encoded \u0645\u062a\u0646"\x2C\n        base64url: "base64url-encoded \u0645\u062a\u0646"\x2C\n        json_string: "JSON \u0645\u062a\u0646"\x2C\n        e164: "\u062f E.164 \u0634\u0645\u06d0\u0631\u0647"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "\u0648\u0631\u0648\u062f\u064a"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "\u0639\u062f\u062f"\x2C\n        array: "\u0627\u0631\u06d0"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `\u0646\u0627\u0633\u0645 \u0648\u0631\u0648\u062f\u064a: \u0628\u0627\u06cc\u062f instanceof ${issue.expected} \u0648\u0627\u06cc\x2C \u0645\u06ab\u0631 ${received} \u062a\u0631\u0644\u0627\u0633\u0647 \u0634\u0648`;\n                }\n                return `\u0646\u0627\u0633\u0645 \u0648\u0631\u0648\u062f\u064a: \u0628\u0627\u06cc\u062f ${expected} \u0648\u0627\u06cc\x2C \u0645\u06ab\u0631 ${received} \u062a\u0631\u0644\u0627\u0633\u0647 \u0634\u0648`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1) {\n                    return `\u0646\u0627\u0633\u0645 \u0648\u0631\u0648\u062f\u064a: \u0628\u0627\u06cc\u062f ${util.stringifyPrimitive(issue.values[0])} \u0648\u0627\u06cc`;\n                }\n                return `\u0646\u0627\u0633\u0645 \u0627\u0646\u062a\u062e\u0627\u0628: \u0628\u0627\u06cc\u062f \u06cc\u0648 \u0644\u0647 ${util.joinValues(issue.values\x2C "|")} \u0685\u062e\u0647 \u0648\u0627\u06cc`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `\u0689\u06cc\u0631 \u0644\u0648\u06cc: ${issue.origin ?? "\u0627\u0631\u0632\u069a\u062a"} \u0628\u0627\u06cc\u062f ${adj}${issue.maximum.toString()} ${sizing.unit ?? "\u0639\u0646\u0635\u0631\u0648\u0646\u0647"} \u0648\u0644\u0631\u064a`;\n                }\n                return `\u0689\u06cc\u0631 \u0644\u0648\u06cc: ${issue.origin ?? "\u0627\u0631\u0632\u069a\u062a"} \u0628\u0627\u06cc\u062f ${adj}${issue.maximum.toString()} \u0648\u064a`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `\u0689\u06cc\u0631 \u06a9\u0648\u0686\u0646\u06cc: ${issue.origin} \u0628\u0627\u06cc\u062f ${adj}${issue.minimum.toString()} ${sizing.unit} \u0648\u0644\u0631\u064a`;\n                }\n                return `\u0689\u06cc\u0631 \u06a9\u0648\u0686\u0646\u06cc: ${issue.origin} \u0628\u0627\u06cc\u062f ${adj}${issue.minimum.toString()} \u0648\u064a`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with") {\n                    return `\u0646\u0627\u0633\u0645 \u0645\u062a\u0646: \u0628\u0627\u06cc\u062f \u062f "${_issue.prefix}" \u0633\u0631\u0647 \u067e\u06cc\u0644 \u0634\u064a`;\n                }\n                if (_issue.format === "ends_with") {\n                    return `\u0646\u0627\u0633\u0645 \u0645\u062a\u0646: \u0628\u0627\u06cc\u062f \u062f "${_issue.suffix}" \u0633\u0631\u0647 \u067e\u0627\u06cc \u062a\u0647 \u0648\u0631\u0633\u064a\u0696\u064a`;\n                }\n                if (_issue.format === "includes") {\n                    return `\u0646\u0627\u0633\u0645 \u0645\u062a\u0646: \u0628\u0627\u06cc\u062f "${_issue.includes}" \u0648\u0644\u0631\u064a`;\n                }\n                if (_issue.format === "regex") {\n                    return `\u0646\u0627\u0633\u0645 \u0645\u062a\u0646: \u0628\u0627\u06cc\u062f \u062f ${_issue.pattern} \u0633\u0631\u0647 \u0645\u0637\u0627\u0628\u0642\u062a \u0648\u0644\u0631\u064a`;\n                }\n                return `${FormatDictionary[_issue.format] ?? issue.format} \u0646\u0627\u0633\u0645 \u062f\u06cc`;\n            }\n            case "not_multiple_of":\n                return `\u0646\u0627\u0633\u0645 \u0639\u062f\u062f: \u0628\u0627\u06cc\u062f \u062f ${issue.divisor} \u0645\u0636\u0631\u0628 \u0648\u064a`;\n            case "unrecognized_keys":\n                return `\u0646\u0627\u0633\u0645 ${issue.keys.length > 1 ? "\u06a9\u0644\u06cc\u0689\u0648\u0646\u0647" : "\u06a9\u0644\u06cc\u0689"}: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `\u0646\u0627\u0633\u0645 \u06a9\u0644\u06cc\u0689 \u067e\u0647 ${issue.origin} \u06a9\u06d0`;\n            case "invalid_union":\n                return `\u0646\u0627\u0633\u0645\u0647 \u0648\u0631\u0648\u062f\u064a`;\n            case "invalid_element":\n                return `\u0646\u0627\u0633\u0645 \u0639\u0646\u0635\u0631 \u067e\u0647 ${issue.origin} \u06a9\u06d0`;\n            default:\n                return `\u0646\u0627\u0633\u0645\u0647 \u0648\u0631\u0648\u062f\u064a`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
