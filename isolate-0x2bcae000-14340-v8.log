script-source,190,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod/v4/locales/pl.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "znak\xf3w"\x2C verb: "mie\u0107" }\x2C\n        file: { unit: "bajt\xf3w"\x2C verb: "mie\u0107" }\x2C\n        array: { unit: "element\xf3w"\x2C verb: "mie\u0107" }\x2C\n        set: { unit: "element\xf3w"\x2C verb: "mie\u0107" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "wyra\u017cenie"\x2C\n        email: "adres email"\x2C\n        url: "URL"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "data i godzina w formacie ISO"\x2C\n        date: "data w formacie ISO"\x2C\n        time: "godzina w formacie ISO"\x2C\n        duration: "czas trwania ISO"\x2C\n        ipv4: "adres IPv4"\x2C\n        ipv6: "adres IPv6"\x2C\n        cidrv4: "zakres IPv4"\x2C\n        cidrv6: "zakres IPv6"\x2C\n        base64: "ci\u0105g znak\xf3w zakodowany w formacie base64"\x2C\n        base64url: "ci\u0105g znak\xf3w zakodowany w formacie base64url"\x2C\n        json_string: "ci\u0105g znak\xf3w w formacie JSON"\x2C\n        e164: "liczba E.164"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "wej\u015bcie"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n        number: "liczba"\x2C\n        array: "tablica"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Nieprawid\u0142owe dane wej\u015bciowe: oczekiwano instanceof ${issue.expected}\x2C otrzymano ${received}`;\n                }\n                return `Nieprawid\u0142owe dane wej\u015bciowe: oczekiwano ${expected}\x2C otrzymano ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Nieprawid\u0142owe dane wej\u015bciowe: oczekiwano ${util.stringifyPrimitive(issue.values[0])}`;\n                return `Nieprawid\u0142owa opcja: oczekiwano jednej z warto\u015bci ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `Za du\u017ca warto\u015b\u0107: oczekiwano\x2C \u017ce ${issue.origin ?? "warto\u015b\u0107"} b\u0119dzie mie\u0107 ${adj}${issue.maximum.toString()} ${sizing.unit ?? "element\xf3w"}`;\n                }\n                return `Zbyt du\u017c(y/a/e): oczekiwano\x2C \u017ce ${issue.origin ?? "warto\u015b\u0107"} b\u0119dzie wynosi\u0107 ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing) {\n                    return `Za ma\u0142a warto\u015b\u0107: oczekiwano\x2C \u017ce ${issue.origin ?? "warto\u015b\u0107"} b\u0119dzie mie\u0107 ${adj}${issue.minimum.toString()} ${sizing.unit ?? "element\xf3w"}`;\n                }\n                return `Zbyt ma\u0142(y/a/e): oczekiwano\x2C \u017ce ${issue.origin ?? "warto\u015b\u0107"} b\u0119dzie wynosi\u0107 ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `Nieprawid\u0142owy ci\u0105g znak\xf3w: musi zaczyna\u0107 si\u0119 od "${_issue.prefix}"`;\n                if (_issue.format === "ends_with")\n                    return `Nieprawid\u0142owy ci\u0105g znak\xf3w: musi ko\u0144czy\u0107 si\u0119 na "${_issue.suffix}"`;\n                if (_issue.format === "includes")\n                    return `Nieprawid\u0142owy ci\u0105g znak\xf3w: musi zawiera\u0107 "${_issue.includes}"`;\n                if (_issue.format === "regex")\n                    return `Nieprawid\u0142owy ci\u0105g znak\xf3w: musi odpowiada\u0107 wzorcowi ${_issue.pattern}`;\n                return `Nieprawid\u0142ow(y/a/e) ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `Nieprawid\u0142owa liczba: musi by\u0107 wielokrotno\u015bci\u0105 ${issue.divisor}`;\n            case "unrecognized_keys":\n                return `Nierozpoznane klucze${issue.keys.length > 1 ? "s" : ""}: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `Nieprawid\u0142owy klucz w ${issue.origin}`;\n            case "invalid_union":\n                return "Nieprawid\u0142owe dane wej\u015bciowe";\n            case "invalid_element":\n                return `Nieprawid\u0142owa warto\u015b\u0107 w ${issue.origin}`;\n            default:\n                return `Nieprawid\u0142owe dane wej\u015bciowe`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
