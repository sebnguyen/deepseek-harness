script-source,198,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/node_modules/.pnpm/zod@4.4.3/node_modules/zod/v4/locales/tr.js,import * as util from "../core/util.js";\nconst error = () => {\n    const Sizable = {\n        string: { unit: "karakter"\x2C verb: "olmal\u0131" }\x2C\n        file: { unit: "bayt"\x2C verb: "olmal\u0131" }\x2C\n        array: { unit: "\xf6\u011fe"\x2C verb: "olmal\u0131" }\x2C\n        set: { unit: "\xf6\u011fe"\x2C verb: "olmal\u0131" }\x2C\n    };\n    function getSizing(origin) {\n        return Sizable[origin] ?? null;\n    }\n    const FormatDictionary = {\n        regex: "girdi"\x2C\n        email: "e-posta adresi"\x2C\n        url: "URL"\x2C\n        emoji: "emoji"\x2C\n        uuid: "UUID"\x2C\n        uuidv4: "UUIDv4"\x2C\n        uuidv6: "UUIDv6"\x2C\n        nanoid: "nanoid"\x2C\n        guid: "GUID"\x2C\n        cuid: "cuid"\x2C\n        cuid2: "cuid2"\x2C\n        ulid: "ULID"\x2C\n        xid: "XID"\x2C\n        ksuid: "KSUID"\x2C\n        datetime: "ISO tarih ve saat"\x2C\n        date: "ISO tarih"\x2C\n        time: "ISO saat"\x2C\n        duration: "ISO s\xfcre"\x2C\n        ipv4: "IPv4 adresi"\x2C\n        ipv6: "IPv6 adresi"\x2C\n        cidrv4: "IPv4 aral\u0131\u011f\u0131"\x2C\n        cidrv6: "IPv6 aral\u0131\u011f\u0131"\x2C\n        base64: "base64 ile \u015fifrelenmi\u015f metin"\x2C\n        base64url: "base64url ile \u015fifrelenmi\u015f metin"\x2C\n        json_string: "JSON dizesi"\x2C\n        e164: "E.164 say\u0131s\u0131"\x2C\n        jwt: "JWT"\x2C\n        template_literal: "\u015eablon dizesi"\x2C\n    };\n    const TypeDictionary = {\n        nan: "NaN"\x2C\n    };\n    return (issue) => {\n        switch (issue.code) {\n            case "invalid_type": {\n                const expected = TypeDictionary[issue.expected] ?? issue.expected;\n                const receivedType = util.parsedType(issue.input);\n                const received = TypeDictionary[receivedType] ?? receivedType;\n                if (/^[A-Z]/.test(issue.expected)) {\n                    return `Ge\xe7ersiz de\u011fer: beklenen instanceof ${issue.expected}\x2C al\u0131nan ${received}`;\n                }\n                return `Ge\xe7ersiz de\u011fer: beklenen ${expected}\x2C al\u0131nan ${received}`;\n            }\n            case "invalid_value":\n                if (issue.values.length === 1)\n                    return `Ge\xe7ersiz de\u011fer: beklenen ${util.stringifyPrimitive(issue.values[0])}`;\n                return `Ge\xe7ersiz se\xe7enek: a\u015fa\u011f\u0131dakilerden biri olmal\u0131: ${util.joinValues(issue.values\x2C "|")}`;\n            case "too_big": {\n                const adj = issue.inclusive ? "<=" : "<";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `\xc7ok b\xfcy\xfck: beklenen ${issue.origin ?? "de\u011fer"} ${adj}${issue.maximum.toString()} ${sizing.unit ?? "\xf6\u011fe"}`;\n                return `\xc7ok b\xfcy\xfck: beklenen ${issue.origin ?? "de\u011fer"} ${adj}${issue.maximum.toString()}`;\n            }\n            case "too_small": {\n                const adj = issue.inclusive ? ">=" : ">";\n                const sizing = getSizing(issue.origin);\n                if (sizing)\n                    return `\xc7ok k\xfc\xe7\xfck: beklenen ${issue.origin} ${adj}${issue.minimum.toString()} ${sizing.unit}`;\n                return `\xc7ok k\xfc\xe7\xfck: beklenen ${issue.origin} ${adj}${issue.minimum.toString()}`;\n            }\n            case "invalid_format": {\n                const _issue = issue;\n                if (_issue.format === "starts_with")\n                    return `Ge\xe7ersiz metin: "${_issue.prefix}" ile ba\u015flamal\u0131`;\n                if (_issue.format === "ends_with")\n                    return `Ge\xe7ersiz metin: "${_issue.suffix}" ile bitmeli`;\n                if (_issue.format === "includes")\n                    return `Ge\xe7ersiz metin: "${_issue.includes}" i\xe7ermeli`;\n                if (_issue.format === "regex")\n                    return `Ge\xe7ersiz metin: ${_issue.pattern} desenine uymal\u0131`;\n                return `Ge\xe7ersiz ${FormatDictionary[_issue.format] ?? issue.format}`;\n            }\n            case "not_multiple_of":\n                return `Ge\xe7ersiz say\u0131: ${issue.divisor} ile tam b\xf6l\xfcnebilmeli`;\n            case "unrecognized_keys":\n                return `Tan\u0131nmayan anahtar${issue.keys.length > 1 ? "lar" : ""}: ${util.joinValues(issue.keys\x2C "\x2C ")}`;\n            case "invalid_key":\n                return `${issue.origin} i\xe7inde ge\xe7ersiz anahtar`;\n            case "invalid_union":\n                return "Ge\xe7ersiz de\u011fer";\n            case "invalid_element":\n                return `${issue.origin} i\xe7inde ge\xe7ersiz de\u011fer`;\n            default:\n                return `Ge\xe7ersiz de\u011fer`;\n        }\n    };\n};\nexport default function () {\n    return {\n        localeError: error()\x2C\n    };\n}\n
