script-source,283,file:///home/snguyen/dev/digitalocean/idk/deepseek-harness/packages/llm/token-meter/lib/index.js,import { Service } from "@deepseek-ai/cordis";\nimport z from "@deepseek-ai/schemastery";\nimport { assembleAssistantStream\x2C lastAssistantStreamChunk } from "@deepseek-ai/dsh-llm";\nimport { deepFreeze } from "@deepseek-ai/dsh-util-values";\nimport { SessionLogOffset\x2C SessionSeq\x2C canonicalHeader\x2C deriveEventMessage\x2C headerEquals\x2C isSurfaceEvent } from "@deepseek-ai/dsh-session";\nimport { z as z$1 } from "zod";\nimport { deriveEventMessage as deriveEventMessage$1 } from "@deepseek-ai/dsh-session/surface";\n//#region lib/types/estimate.js\n/**\n* Fixed-density heuristic token pricing shared by the meter service and the\n* pure context-breakdown projection\x2C so both surfaces price identical content\n* to identical numbers.\n*\n* @module @deepseek-ai/dsh-token-meter/estimate\n*/\n/** Fixed text-density estimate used until exact tokenization is needed. */\nconst CHARS_PER_TOKEN = 4;\n/** Per-block structural overhead for JSON framing and type tags. */\nconst BLOCK_OVERHEAD = 4;\n/**\n* Structural JSON price of one block outside the typed pricing arms: the\n* fixed heuristic for merge-extended blocks and for image references\x2C whose\n* request price is route-owned rather than fixed.\n* @param block - block to price without mutation.\n* @returns heuristic tokens for the block's JSON structure.\n*/\nfunction estimateStructuralBlock(block) {\n\x09return BLOCK_OVERHEAD + Math.ceil(JSON.stringify(block).length / CHARS_PER_TOKEN);\n}\n/**\n* Price content blocks recursively under the fixed density heuristic.\n* @param blocks - content blocks to price without mutation.\n* @returns heuristic tokens including per-block structural overhead.\n*/\nfunction estimateContent(blocks) {\n\x09let tokens = 0;\n\x09for (const block of blocks) switch (block.type) {\n\x09\x09case "text":\n\x09\x09case "reasoning":\n\x09\x09\x09tokens += Math.ceil(block.text.length / CHARS_PER_TOKEN) + BLOCK_OVERHEAD;\n\x09\x09\x09break;\n\x09\x09case "tool-call":\n\x09\x09\x09tokens += Math.ceil(block.name.length / CHARS_PER_TOKEN) + Math.ceil(block.arguments.length / CHARS_PER_TOKEN) + BLOCK_OVERHEAD;\n\x09\x09\x09break;\n\x09\x09case "tool-result":\n\x09\x09\x09tokens += estimateContent(block.content) + BLOCK_OVERHEAD;\n\x09\x09\x09break;\n\x09\x09default: tokens += estimateStructuralBlock(block);\n\x09}\n\x09return tokens;\n}\n/**\n* Price the rendered system prompt: the `system/message` surface node's text.\n* Adapters serialize the prompt as a plain string \u2014 a system-role message or\n* the request's system field \u2014 not as a typed content block\x2C so the price is\n* text density plus role framing with no per-block overhead.\n* @param message - system-role message to price without mutation.\n* @returns heuristic system-prompt tokens; 0 for empty content ("no system prompt").\n*/\nfunction estimateSystemMessage(message) {\n\x09if (message.content.length === 0) return 0;\n\x09let characters = 0;\n\x09for (const block of message.content) characters += block.type === "text" ? block.text.length : JSON.stringify(block).length;\n\x09return Math.ceil(characters / CHARS_PER_TOKEN) + 4;\n}\n/**\n* Heuristically price one model-visible message.\n* @param message - message to price without mutation.\n* @returns content and role-framing tokens under the fixed heuristic; a\n*   system-role message prices as {@link estimateSystemMessage}.\n*/\nfunction estimateMessage(message) {\n\x09if (message.role === "system") return estimateSystemMessage(message);\n\x09return estimateContent(message.content) + 4;\n}\n/**\n* Price the tool-schema part of a canonical request envelope \u2014 the envelope's\n* only priced field\x2C since the system prompt is a surface node.\n* @param header - canonical envelope\x2C or undefined before any request.\n* @returns heuristic tool-schema tokens; 0 when absent or empty.\n*/\nfunction estimateToolsTokens(header)